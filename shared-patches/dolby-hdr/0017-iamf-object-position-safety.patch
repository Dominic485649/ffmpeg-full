+        element->default_azimuth = values[0][0];
+        element->default_elevation = values[0][1];
+        element->default_distance = values[0][2];
+        element->default_azimuth2 = values[1][0];
+        element->default_elevation2 = values[1][1];
+        element->default_distance2 = values[1][2];
+    } else {
+        element->default_x = values[0][0];
+        element->default_y = values[0][1];
+        element->default_z = values[0][2];
+        element->default_x2 = values[1][0];
+        element->default_y2 = values[1][1];
+        element->default_z2 = values[1][2];
+    }
