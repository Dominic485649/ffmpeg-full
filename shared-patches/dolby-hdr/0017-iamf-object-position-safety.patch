+static size_t position_param_size(const AVIAMFParamDefinition *param)
+{
+    if (!param || param->subblocks_offset < sizeof(*param) ||
+        !param->subblock_size ||
+        param->nb_subblocks > (SIZE_MAX - param->subblocks_offset) / param->subblock_size)
+        return 0;
+
+    return param->subblocks_offset + param->nb_subblocks * param->subblock_size;
