+
+static int update_position_param(IAMFDemuxContext *c,
+                                 const AVIAMFParamDefinition *param,
+                                 size_t param_size)
+{
+    const int slot = param->type - AV_IAMF_PARAMETER_DEFINITION_POLAR;
+    size_t offset = 0, old_record_size = 0;
+    int found = 0;
+
+    if (slot < 0 || slot >= FF_ARRAY_ELEMS(c->position) ||
+        position_param_size(param) != param_size)
+        return AVERROR_INVALIDDATA;
+
+    while (offset < c->position_size[slot]) {
+        const AVIAMFParamDefinition *old;
+        size_t record_size;
+
+        if (c->position_size[slot] - offset < sizeof(*old))
+            return AVERROR_INVALIDDATA;
+        old = (const AVIAMFParamDefinition *)(c->position[slot] + offset);
+        record_size = position_param_size(old);
+        if (!record_size || record_size > c->position_size[slot] - offset)
+            return AVERROR_INVALIDDATA;
+        if (old->parameter_id == param->parameter_id) {
+            found = 1;
+            old_record_size = record_size;
+            break;
+        }
+        offset += record_size;
+    }
+
+    if (found) {
+        size_t new_size = c->position_size[slot] - old_record_size + param_size;
+        uint8_t *new_data = av_malloc(new_size);
+        if (!new_data)
+            return AVERROR(ENOMEM);
+        memcpy(new_data, c->position[slot], offset);
+        memcpy(new_data + offset, param, param_size);
+        memcpy(new_data + offset + param_size,
+               c->position[slot] + offset + old_record_size,
+               c->position_size[slot] - offset - old_record_size);
+        av_freep(&c->position[slot]);
+        c->position[slot] = new_data;
+        c->position_size[slot] = new_size;
+    } else {
+        uint8_t *new_data;
+        if (param_size > SIZE_MAX - c->position_size[slot])
+            return AVERROR(ENOMEM);
+        new_data = av_realloc(c->position[slot], c->position_size[slot] + param_size);
+        if (!new_data)
+            return AVERROR(ENOMEM);
+        memcpy(new_data + c->position_size[slot], param, param_size);
+        c->position[slot] = new_data;
+        c->position_size[slot] += param_size;
+    }
