+    value_count = animation == AV_IAMF_ANIMATION_TYPE_STEP ? 1 :
+                  animation == AV_IAMF_ANIMATION_TYPE_INTER_LINEAR ? 1 : 2;
+    first_point = animation == AV_IAMF_ANIMATION_TYPE_STEP ? 0 : 1;
+    for (int object = 0; object < (dual ? 2 : 1); object++)
+        for (int axis = 0; axis < 3; axis++)
+            bits += (polar ? (axis == 0 ? 9 : axis == 1 ? 8 : 7) : cart_bits) *
+                    value_count + (animation == AV_IAMF_ANIMATION_TYPE_INTER_BEZIER ? 8 : 0);
