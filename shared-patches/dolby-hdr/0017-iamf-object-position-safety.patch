+static int of_prepare_iamf_mix_gain_param(Muxer *mux,
+                                           AVIAMFParamDefinition **pparam,
+                                           AVDictionary **pdict,
+                                           const char *token)
+{
+    const AVDictionaryEntry *entry;
+    AVDictionary *dict = *pdict;
+    unsigned int duration = 0, constant_duration = 0, nb_subblocks = 0;
+    const char *p;
+
+    entry = av_dict_get(dict, "duration", NULL, 0);
+    if (entry) {
+        char *end;
+        unsigned long value = strtoul(entry->value, &end, 0);
+        if (*end || value > UINT_MAX)
+            return AVERROR(EINVAL);
+        duration = value;
+    }
+    entry = av_dict_get(dict, "constant_subblock_duration", NULL, 0);
+    if (entry) {
+        char *end;
+        unsigned long value = strtoul(entry->value, &end, 0);
+        if (*end || value > UINT_MAX)
+            return AVERROR(EINVAL);
+        constant_duration = value;
+    }
+
+    if (duration && constant_duration) {
+        nb_subblocks = duration / constant_duration + (duration % constant_duration != 0);
+    } else if (duration) {
+        for (p = token; (p = strstr(p, "subblock_duration=")); p++) {
+            if (p == token || p[-1] == ':')
+                nb_subblocks++;
+        }
+    }
+    if (nb_subblocks > 1024) {
+        av_log(mux, AV_LOG_ERROR, "Too many IAMF mix-gain subblocks: %u\n", nb_subblocks);
+        return AVERROR(EINVAL);
+    }
+
+    if ((*pparam)->nb_subblocks != nb_subblocks) {
+        AVIAMFParamDefinition *param = av_iamf_param_definition_alloc(
+            AV_IAMF_PARAMETER_DEFINITION_MIX_GAIN, nb_subblocks, NULL);
+        if (!param)
+            return AVERROR(ENOMEM);
+        param->parameter_id = (*pparam)->parameter_id;
+        param->parameter_rate = (*pparam)->parameter_rate;
+        av_free(*pparam);
+        *pparam = param;
+    }
+
+    if (duration && !constant_duration) {
+        unsigned int index = 0;
+        for (p = token; (p = strstr(p, "subblock_duration=")); p++) {
+            unsigned int value;
+            char *end;
+            if (p != token && p[-1] != ':')
+                continue;
+            value = strtoul(p + strlen("subblock_duration="), &end, 0);
+            if (end == p + strlen("subblock_duration=") || value > UINT_MAX ||
+                index >= nb_subblocks)
+                return AVERROR(EINVAL);
+            ((AVIAMFMixGain *)av_iamf_param_definition_get_subblock(*pparam, index++))->subblock_duration = value;
+        }
+        if (index != nb_subblocks)
+            return AVERROR_INVALIDDATA;
+    }
+
+    av_dict_set(pdict, "subblock_duration", NULL, 0);
+    av_dict_set(pdict, "animation_type", NULL, 0);
+    av_dict_set(pdict, "start_point_value", NULL, 0);
+    av_dict_set(pdict, "end_point_value", NULL, 0);
+    av_dict_set(pdict, "control_point_value", NULL, 0);
+    av_dict_set(pdict, "control_point_relative_time", NULL, 0);
+    return 0;
+}
