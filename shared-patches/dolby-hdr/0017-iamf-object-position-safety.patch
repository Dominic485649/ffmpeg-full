+static int put_position_default(PutBitContext *pb, int value, int bits, int is_signed)
+{
+    int64_t min = is_signed ? -(INT64_C(1) << (bits - 1)) : 0;
+    int64_t max = is_signed ? (INT64_C(1) << (bits - 1)) - 1 :
+                              (INT64_C(1) << bits) - 1;
+
+    if (value < min || value > max)
+        return AVERROR(EINVAL);
+    if (is_signed)
+        put_sbits(pb, bits, value);
+    else
+        put_bits(pb, bits, value);
+    return 0;
+}
+
+static int write_position_defaults(AVIOContext *pb, unsigned int type,
+                                   const AVIAMFSubmixElement *element)
+{
+    int values[2][3];
+    const int polar = type == AV_IAMF_PARAMETER_DEFINITION_POLAR ||
+                      type == AV_IAMF_PARAMETER_DEFINITION_DUAL_POLAR;
+    const int dual = type == AV_IAMF_PARAMETER_DEFINITION_DUAL_POLAR ||
+                     type == AV_IAMF_PARAMETER_DEFINITION_DUAL_CART8 ||
+                     type == AV_IAMF_PARAMETER_DEFINITION_DUAL_CART16;
+    const int cart_bits = type == AV_IAMF_PARAMETER_DEFINITION_CART16 ||
+                          type == AV_IAMF_PARAMETER_DEFINITION_DUAL_CART16 ? 16 :
+                          type == AV_IAMF_PARAMETER_DEFINITION_CART8 ||
+                          type == AV_IAMF_PARAMETER_DEFINITION_DUAL_CART8 ? 8 : 0;
+    uint8_t data[12] = { 0 };
+    PutBitContext pbc;
+
+    if (polar) {
+        values[0][0] = element->default_azimuth;
+        values[0][1] = element->default_elevation;
+        values[0][2] = element->default_distance;
+        values[1][0] = element->default_azimuth2;
+        values[1][1] = element->default_elevation2;
+        values[1][2] = element->default_distance2;
+    } else {
+        values[0][0] = element->default_x;
+        values[0][1] = element->default_y;
+        values[0][2] = element->default_z;
+        values[1][0] = element->default_x2;
+        values[1][1] = element->default_y2;
+        values[1][2] = element->default_z2;
+    }
+
+    init_put_bits(&pbc, data, sizeof(data));
+    for (int object = 0; object < (dual ? 2 : 1); object++) {
+        for (int axis = 0; axis < 3; axis++) {
+            int bits = polar ? (axis == 0 ? 9 : axis == 1 ? 8 : 7) : cart_bits;
+            int is_signed = !polar || axis < 2;
+            int ret = put_position_default(&pbc, values[object][axis], bits, is_signed);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    flush_put_bits(&pbc);
+    avio_write(pb, data, put_bytes_count(&pbc, 1));
+    return 0;
+}
