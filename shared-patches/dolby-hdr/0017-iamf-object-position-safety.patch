+            animation != AV_IAMF_ANIMATION_TYPE_INTER_LINEAR)
+            return AVERROR_INVALIDDATA;
+    } else if (animation != AV_IAMF_ANIMATION_TYPE_STEP &&
+               animation != AV_IAMF_ANIMATION_TYPE_INTER_LINEAR &&
+               animation != AV_IAMF_ANIMATION_TYPE_INTER_BEZIER) {
+        return AVERROR_INVALIDDATA;
+    }
