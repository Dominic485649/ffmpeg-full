From 3ee5b8001ab9331da77bc402a73b31b66d1aaa54 Mon Sep 17 00:00:00 2001
From: REPLACE-ME <replace-me@example.com>
Date: Mon, 28 Sep 2026 02:25:13 +0800
Subject: [PATCH] avcodec/libsvtav1: pass HDR10+ metadata through the T35 metadata OBU

libsvtav1.c already has a working path for per-picture ITU-T T.35 metadata:
svt_add_metadata(headerPtr, EB_AV1_METADATA_TYPE_ITUT_T35, ...) is called for
Dolby Vision RPUs, and the same call is what carries HDR10+ (SMPTE ST 2094-40)
in AV1 per the "HDR10+ AV1 Metadata Handling Specification" section 2.1.

AVFrame side data of type AV_FRAME_DATA_DYNAMIC_HDR_PLUS is therefore dropped
on the floor today: the encoder emits METADATA_TYPE_HDR_CLL /
METADATA_TYPE_HDR_MDCV from the stream-level MDCV/CLL side data, but nothing
reads the frame-level dynamic metadata, so an HDR10+ source loses it whenever
the user picks SVT-AV1.

Add add_hdr_plus(), mirroring libaomenc.c's add_hdr_plus(): -
av_dynamic_hdr_plus_to_t35() serialises the ST 2094-40 payload but excludes
the 48-bit itu_t_t35 header, so prepend country code 0xB5 (US), provider code
0x003C, provider oriented code 0x0001 and application identifier 0x04; - call
it with data == NULL first to get the size, then with the pointer sitting
behind that header so it writes in place (the API treats *data non-NULL as
"caller-provided buffer, *data-sized capacity"); - hand the result to the
existing svt_add_metadata() T35 channel.

It is called from eb_send_frame, next to the Dolby Vision branch, because
HDR10+ is per-picture. When a frame carries both this side data and a Dolby
Vision RPU, the branch below writes its RPU through the same T35 channel, so
the temporal unit would carry two metadata OBUs of type 4: the syntax allows
that (a decoder is meant to tell them apart by the T.35 provider code), but
the reader measured here keeps only the last T35 OBU of a unit, so one of the
two blocks can never be read back - the shape that cost 5 of 12 blocks their
metadata. add_hdr_plus() therefore skips the HDR10+ write when the RPU really
is going in (gated on the same dv_profile predicate the RPU write uses, so
-dolbyvision 0 still delivers HDR10+) and says so once at warning level. A
frame without HDR10+ side data stays the no-op it was.

Verification (see README): the T35 channel was exercised directly against
SVT-AV1 4.2.0's own library - svt_add_metadata() with a 55-byte HDR10+ payload
produces one OBU with metadata_type=4 whose payload is byte-identical to the
input, and ffprobe then reports it as "HDR Dynamic Metadata SMPTE2094-40
(HDR10+)" frame side data; the same encode without the call produces none, at
both 8-bit and 10-bit.

The translation unit also compiles now: cl -W3 -std:c17 against this tree's
headers plus SVT-AV1's own API directory, with the pristine libsvtav1.c as the
control arm under identical flags (control exit 0, patch arm exit 0).
Warnings: control 16, patch 16, same distribution (14 inside libsvtav1.c, 2
inside intmath.h), re-measured 2026-10-02 - the patch adds no diagnostic of
its own. It also no longer includes libavcodec/bytestream.h for anything: an
earlier revision did, and those macros' unchecked pointer arithmetic was
drawing 16 extra C4244 lines; the six identity bytes are plain stores now,
byte-for-byte the same sequence. That arm caught a defect the first revision
of this patch carried: it used AVDynamicHDRPlus and
av_dynamic_hdr_plus_to_t35() without including
libavutil/hdr_dynamic_metadata.h - the header libaomenc.c, whose
add_hdr_plus() is mirrored here, includes - so `git apply` came out clean
while the file did not build (C2065 "hdr_plus: undeclared identifier"). The
include is added above.

Signed-off-by: REPLACE-ME <replace-me@example.com>

---

Still unverified: the hunk allocates av_malloc(payload_size +
HDR10PLUS_T35_HEADER_SIZE) and carries no size cap of its own (no
sizeof/length guard in the added lines) - the only bound is whatever the SDK
enforces, which is untested here.

Verified since that sentence was first written, on this box: the patch
compiles inside a whole FFmpeg build and is used for an encode through
libavcodec's libsvtav1 wrapper - a tree configured --enable-libsvtav1 against
the real SVT v4.2.0 SDK, 33 PASS / 0 FAIL (p5probe/svt-e2e-20261001.log),
12/12 temporal units carrying one T35 each with the payload byte-identical to
the input, agreeing across IVF/MP4/MKV. Multi-picture temporal units are no
longer untested either: with multi-frame and re-display units present, 12/12
T35 land, and the placement rule that survived is the weaker one - the T35
sits immediately before the displayable picture, NOT before every
picture-carrying OBU in the unit (zero-one/0001-tu-composition-20261002.log,
10 PASS / 1 FAIL, where the FAIL is exactly that stronger claim).
 libavcodec/libsvtav1.c | +99/-0, 4 hunks

diff --git a/libavcodec/libsvtav1.c b/libavcodec/libsvtav1.c
index 0bcc176..31b765b 100644
--- a/libavcodec/libsvtav1.c
+++ b/libavcodec/libsvtav1.c
@@ -29,6 +29,7 @@
 #include "libavutil/attributes.h"
 #include "libavutil/common.h"
 #include "libavutil/frame.h"
+#include "libavutil/hdr_dynamic_metadata.h"
 #include "libavutil/imgutils.h"
 #include "libavutil/base64.h"
 #include "libavutil/intreadwrite.h"
@@ -146,6 +147,15 @@ static int alloc_buffer(EbSvtAv1EncConfiguration *config, SvtContext *svt_enc)
 
 }
 
+
+/* HDR10+ dynamic metadata (SMPTE ST 2094-40) carried in an AV1 T35 metadata
+ * OBU, per "HDR10+ AV1 Metadata Handling Specification" v1.0.1, section 2.1. */
+#define ITU_T_T35_COUNTRY_CODE_US        0xB5
+#define ITU_T_T35_PROVIDER_CODE_SAMSUNG  0x003C
+#define HDR10PLUS_PROVIDER_ORIENTED_CODE  0x0001
+#define HDR10PLUS_APPLICATION_IDENTIFIER  0x04
+#define HDR10PLUS_T35_HEADER_SIZE         6
+
 static void handle_mdcv(struct EbSvtAv1MasteringDisplayInfo *dst,
                         const AVMasteringDisplayMetadata *mdcv)
 {
@@ -184,6 +194,90 @@ static void handle_mdcv(struct EbSvtAv1MasteringDisplayInfo *dst,
     }
 }
 
+
+static int add_hdr_plus(AVCodecContext *avctx, EbBufferHeaderType *headerPtr,
+                        const AVFrame *frame, int dv_profile)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(frame,
+                                                       AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+    const AVDynamicHDRPlus *hdr_plus;
+    uint8_t *buf, *payload;
+    size_t payload_size;
+    int ret;
+
+    if (!sd)
+        return 0;
+
+    /* A Dolby Vision input is written as a T.35 metadata OBU just below this call, in
+     * eb_send_frame(), through the same svt_add_metadata(EB_AV1_METADATA_TYPE_ITUT_T35) channel
+     * used here. Writing HDR10+ into the same temporal unit then puts two metadata OBUs of
+     * type 4 in it: the syntax allows that - a decoder is supposed to tell them apart by the
+     * T.35 provider code - but the reader measured here keeps only the last T.35 OBU of a
+     * unit, so one of the two blocks cannot be read back at all, which is the shape that cost
+     * 5 of 12 blocks their metadata. Deliver the source's own RPU and skip the HDR10+ block
+     * rather than emit a pair the consumer resolves to one of them, and say so out loud once
+     * (the function-static warn-once flag follows dnxhddec.c:511). dv_profile is the same
+     * predicate eb_send_frame() gates the RPU write on, so this only bites when a second type-4
+     * OBU really is going into the unit. */
+    if (dv_profile && av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA)) {
+        static int dovi_conflict_warned;
+
+        if (!dovi_conflict_warned) {
+            dovi_conflict_warned = 1;
+            av_log(avctx, AV_LOG_WARNING, "Frame carries both Dolby Vision and HDR10+ metadata. "
+                   "Both are delivered as a T35 metadata OBU with metadata_type 4 in the same "
+                   "temporal unit, and a reader keeps only the last one, so the HDR10+ metadata "
+                   "is being skipped for this encode - the Dolby Vision RPU is still written. "
+                   "Enable -dolbyvision 0 to send the HDR10+ metadata instead. "
+                   "This message is shown once.\n");
+        }
+        return 0;
+    }
+
+    hdr_plus = (const AVDynamicHDRPlus *)sd->data;
+
+    /* First call with data == NULL only queries the serialized size. */
+    ret = av_dynamic_hdr_plus_to_t35(hdr_plus, NULL, &payload_size);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Error finding the size of HDR10+\n");
+        return ret;
+    }
+
+    buf = av_malloc(payload_size + HDR10PLUS_T35_HEADER_SIZE);
+    if (!buf)
+        return AVERROR(ENOMEM);
+
+    payload = buf;
+    /* Six stores written by hand rather than bytestream_put_byte/put_be16: each macro's unchecked
+     * pointer arithmetic is separately diagnosed under /W3 by MSVC - 16 extra C4244 lines for four
+     * calls - and this header has a fixed length with no bounds logic to gain. */
+    *payload++ = ITU_T_T35_COUNTRY_CODE_US;
+    *payload++ = (uint8_t)(ITU_T_T35_PROVIDER_CODE_SAMSUNG >> 8);
+    *payload++ = (uint8_t)(ITU_T_T35_PROVIDER_CODE_SAMSUNG & 0xFF);
+    *payload++ = (uint8_t)((HDR10PLUS_PROVIDER_ORIENTED_CODE >> 8) & 0xFF);
+    *payload++ = (uint8_t)(HDR10PLUS_PROVIDER_ORIENTED_CODE & 0xFF);
+    *payload++ = HDR10PLUS_APPLICATION_IDENTIFIER;
+
+    /* With *data non-NULL to_t35 writes in place; size is in/out and must
+     * already hold the capacity. */
+    ret = av_dynamic_hdr_plus_to_t35(hdr_plus, &payload, &payload_size);
+    if (ret < 0) {
+        av_free(buf);
+        av_log(avctx, AV_LOG_ERROR, "Error encoding HDR10+ from side data\n");
+        return ret;
+    }
+
+    ret = svt_add_metadata(headerPtr, EB_AV1_METADATA_TYPE_ITUT_T35, buf,
+                           payload_size + HDR10PLUS_T35_HEADER_SIZE);
+    av_free(buf);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Error adding HDR10+ to SVT-AV1 buffer\n");
+        return AVERROR(ENOMEM);
+    }
+
+    return 0;
+}
+
 static void handle_side_data(AVCodecContext *avctx,
                              EbSvtAv1EncConfiguration *param)
 {
@@ -595,6 +689,11 @@ static int eb_send_frame(AVCodecContext *avctx, const AVFrame *frame)
     if (avctx->gop_size == 1)
         headerPtr->pic_type = EB_AV1_KEY_PICTURE;
 
+    ret = add_hdr_plus(avctx, headerPtr, frame, svt_enc->dovi.cfg.dv_profile);
+    if (ret < 0)
+        return ret;
+
+
     sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA);
     if (svt_enc->dovi.cfg.dv_profile && sd) {
         const AVDOVIMetadata *metadata = (const AVDOVIMetadata *)sd->data;

-- 
