+/**
+ * @file
+ * Apply the Dolby Vision RPU reshaping curves to a base layer, producing the
+ * signal the metadata was authored for.
+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include "libavutil/avassert.h"
+#include "libavutil/common.h"
+#include "libavutil/dovi_meta.h"
+#include "libavutil/frame.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavutil/rational.h"
+
+#include "avfilter.h"
+#include "filters.h"
+#include "formats.h"
+#include "avfilter_internal.h"
+#include "video.h"
+
+enum ChromaRebuild {
+    CHROMA_NEAREST,
+    CHROMA_BILINEAR,
+    CHROMA_NB
+};
+
+/*
+ * What the transfer slot between the DM's two matrices holds for a Profile 5 base layer.
+ *
+ * The bitstream does NOT decide it. `signal_eotf` is the field that nominally would, but on the
+ * ICtCp material this was developed against it carries no code at all: measured 65535 on all three
+ * items with signal_eotf_param0/1/2 all zero, and research report 63 established that combination
+ * as a derived sentinel rather than a declaration of PQ. Nor does self-consistency separate the
+ * candidates - each arm closes its own round trip. Only the numbers differ, and they differ
+ * substantially: measured on the corrected component-plane path (report 42.2,
+ * p5probe/p5-path-orientation-20260929.log), one frame of the shine item peaks at 1833 cd/m2
+ * under the cube arm and 180 cd/m2 under the PQ arm, against the 1000.6 cd/m2 reference white that
+ * very stream declares. The report's own verdict on that pair is that the cube arm is consistently
+ * nearer but by less than half an octave - explicitly NOT strong enough to adjudicate (it withdrew
+ * an earlier, over-read version of the same comparison in report 42).
+ *
+ * So there is no default here: the caller declares the arm, and an undeclared ICtCp frame is
+ * refused rather than silently given whichever transfer I would have picked.
+ */
+enum P5Transfer {
+    P5_TRANSFER_CBRT,   /* sign(x)*|x|^3, the cube root the P5 authored signal is inverted with */
+    P5_TRANSFER_PQ,     /* ST 2084 EOTF on the normalised code, 1.0 == 10000 cd/m2 */
+    P5_TRANSFER_NB
+};
+
+/*
+ * How the enhancement layer is brought onto the base layer's raster before the two are composed.
+ *
+ * NAME THIS HONESTLY: only one of these three is the shape the format asks for, one is an
+ * informative reference that covers ONE direction, and the third is a stand-in this kit invented.
+ *
+ *   EL_REBUILD_IDENTITY  - ETSI GS CCM 001 clause 5.2.2 a) says the BL and EL pictures "shall have
+ *                          the same vertical and horizontal resolution", so on conformant material
+ *                          nothing is resampled at all. The clause number is quoted because this is
+ *                          the only arm with a normative basis.
+ *   EL_REBUILD_REPEAT    - the exact integer ratio: each EL sample replicated over its BL cell when
+ *                          the EL is smaller, every n-th sample taken from the top-left when it is
+ *                          larger. THIS IS A STAND-IN, NOT A STANDARD. `el_spatial_resampling_filter_flag`
+ *                          selects a normative filter whose identity is NOT carried by the stream -
+ *                          it is a single bit, not a selector (see the dossier, section C.2) - so
+ *                          the phase below is a declaration by the caller, which is why the caller
+ *                          has to make it. Annex B.3 of CCM 001 does publish a reference upsampler,
+ *                          but it is INFORMATIVE, and it defines only the UPSAMPLING direction
+ *                          (every published tap is written `r[2n]` / `r[2n+1]`); it contains no
+ *                          decimation filter. That reference is deliberately NOT wired here: wiring
+ *                          it would take a filter the standard marks informative and present it as
+ *                          the reason the picture is right, and lane E's dossier measured that this
+ *                          kit's own gates use the integer stand-in for BOTH directions. Naming it
+ *                          `annexb` in an option would be the lie, not the omission.
+ *   EL_REBUILD_DECIMATE  - the same stand-in in the other direction, split out so a caller cannot
+ *                          reach the decimation path by accident: on the LG subject the EL is
+ *                          smaller and on the CES subject it is larger, and "one option meaning
+ *                          both" is how a caller ends up declaring the wrong one and getting a
+ *                          plausible picture anyway - the failure shape this filter refuses
+ *                          everywhere else.
+ */
+enum ElRebuild {
+    EL_REBUILD_REPEAT,     /* stand-in: integer repeat, EL smaller than BL */
+    EL_REBUILD_DECIMATE,   /* stand-in: integer decimation, EL larger than BL */
+    EL_REBUILD_IDENTITY,   /* CCM 001 5.2.2 a): same raster, no resampling - the conformant shape */
+    EL_REBUILD_NB
+};
+
+/*
+ * Where the EL's zero residual sits. The bitstream does NOT settle it: it declares `nlq_offset`,
+ * but on the CES 00004 pair the EL's own coded luma median is code 64 (studio black) while the RPU
+ * declares nlq_offset = 512 for all three components, so the two candidates disagree by construction
+ * on real material. They also differ in what they MEAN:
+ *
+ *   EL_NEUTRAL_NLQ      - the format's own neutral: clause 5.4.3.2's `rr = e - nlq_offset` with its
+ *                         `rr == 0 -> r = 0` carve-out. This is what the clause and the one shipped
+ *                         reference implementation both do (libplacebo shaders/colorspace.c:143),
+ *                         so it is the arm an output is authored with.
+ *   EL_NEUTRAL_MEDIAN   - the EL's own per-component coded median. A DIAGNOSTIC: it is never a
+ *                         choice to ship on, because it makes the picture depend on this file's
+ *                         distribution rather than on what the stream declared. It exists so the
+ *                         disagreement above can be MEASURED instead of argued about.
+ *
+ * Both are declarations rather than a default because the choice moves the composed picture: report
+ * 73 measured nlq 1097 against the CES item's own median on one component, and the gate that
+ * consumes this reads 499.7 cd/m2 under one arm and 1097.4 under the other on the same frame.
+ */
+enum ElNeutral {
+    EL_NEUTRAL_NLQ,
+    EL_NEUTRAL_MEDIAN,
+    EL_NEUTRAL_NB
+};
+
+/*
+ * ------------------------------------------------------------------ the EL input description
+ *
+ * The enhancement layer arrives as planes, not as an AVFrame. That is a deliberate shape, not a
+ * shortcut: dovi_apply_planes() has no AVFilterLink and no AVFrame in its signature, and the
+ * comment at the top of this file records why - so the arithmetic "can be called, and therefore
+ * checked, outside a graph". Handing this function an AVFrame would undo that property at the one
+ * place it is worth the most, because the compose is the part whose ordering error no downstream
+ * number can see.
+ *
+ * EL is NOT carried in frame side data and is NOT a second input pad in this revision. Adding a pad
+ * would change filter_frame() into activate(), and the two pad frames' pts then have to be paired -
+ * a real precondition (the kit measured that reversing the EL's timestamps is what a pairing gate
+ * stops) that belongs with the pad, not here. This stage integrates the ARITHMETIC with the input
+ * described explicitly, so that whichever container is chosen next has one thing left to prove.
+ *
+ * The fields are declared before the filter context because the context HOLDS one: the host that
+ * drives this step outside a graph fills it in, which is why it is a struct and not four parallel
+ * arguments.
+ */
+typedef struct DoviElInput {
+    const uint16_t *plane[3];
+    ptrdiff_t stride[3];   /* in SAMPLES, not bytes - the same convention as dovi_apply_planes() */
+    int width, height;     /* the EL's own LUMA raster, which is NOT assumed to be the BL's */
+    int bit_depth;         /* the EL's own depth, which is NOT assumed to equal hdr->el_bit_depth */
+    int present;           /* 0 means "single layer": every EL path below is skipped */
+
+    /*
+     * THE CHROMA RASTER, and its absence was a crash rather than a rounding error.
+     *
+     * `dovi_el_cell()` maps a base-layer pixel onto the EL's LUMA raster, so it yields `sx`/`sy` in
+     * 0..el->width-1 / 0..el->height-1. `dovi_el_residual_at()` then indexes EVERY component's
+     * plane with that pair. That is correct only when all three planes share the luma raster.
+     *
+     * On real material they do not: an enhancement layer arrives as `yuv420p10le`, whose chroma
+     * planes are half resolution in both directions, so `sx` running to el->width-1 walks off the
+     * end of a plane that is half as wide - an access violation, found by driving the filter through
+     * a real filtergraph (the host-driven P1 arms modelled the EL as 4:4:4 with one full-width
+     * stride for all three planes, so this path had never been exercised with a real decoded EL).
+     *
+     * Declared explicitly rather than inferred from a pixel format, because this struct is also
+     * filled by hosts that own their own buffers: `chroma_w`/`chroma_h` say what the caller actually
+     * laid out. A caller delivering 4:4:4 sets them equal to width/height, which is exactly what the
+     * P1 arms did and why they worked.
+     */
+    int chroma_w, chroma_h;
+} DoviElInput;
+
+/*
+ * ------------------------------------------------------------------ clause 5.4.3.2/5.4.3.3, the compose
+ *
+ * THE ONE INPUT THAT IS NOT A uint16 PLANE, AND WHY
+ * `resh_f64`, when non-NULL, replaces the curve's output for every pixel with the values it points
+ * at (three planes, BL order, float64). It exists for the TEST HOST and for nothing else, and the
+ * reason is a measured one rather than a convenience: the residual is added to the curve's OUTPUT,
+ * so a comparison against a reference that computed that output itself is only meaningful if BOTH
+ * sides hold the same output. Delivering it through a uint16 plane instead re-quantises it to
+ * 1/(2^bl_bit_depth - 1) on the way in, and the kit's own plan says in as many words that the
+ * zero-tolerance arms "hold only when no integer lands in the middle" (fel-C侧实现规划 §7.0). Measured
+ * on this subject, a 10-bit delivery perturbed 407,288 of 24,883,200 samples - the same order as the
+ * whole acceptance, so it would have been the driver being judged rather than the filter.
+ *
+ * In a filtergraph this is always NULL: the curve runs, and `resh` is the curve's own output.
+ */
+typedef struct DoviReshOverride {
+    const double *plane[3];   /* BL order, one plane per component, normalised [0,1] */
+    int present;
+} DoviReshOverride;
+
+typedef struct DolbyApplyContext {
+    const AVClass *class;
+
+    int chroma;   /* enum ChromaRebuild; -1 until declared, which is an error */
+    int p5_transfer;  /* enum P5Transfer; -1 until declared. Only consulted for an ICtCp stream,
+                       * so unlike `chroma` an undeclared value is not an init failure: a P8 stream
+                       * must keep working with no new option. */
+    int el_rebuild;   /* enum ElRebuild; -1 until declared. Demanded only of a dual-layer frame,
+                       * for the same reason: a single-layer P8 stream must keep working with no
+                       * new option at all. */
+    int el_neutral;   /* enum ElNeutral; -1 until declared. Same demand rule as el_rebuild. */
+
+    /* Where the enhancement layer's pixels come from. A POINTER, and NULL until a caller sets it:
+     * this revision integrates the compose arithmetic with the EL DESCRIBED EXPLICITLY rather than
+     * pulled from a second input pad, so that the container question (two pads, and the pts pairing
+     * they imply) stays a separate, separately provable step. It is the same reason
+     * dovi_apply_planes() takes planes rather than an AVFrame - see the file-top comment. Setting it
+     * is what makes `el_present` true; filter_frame() never invents it. */
+    DoviElInput el;
+    int el_present;
+} DolbyApplyContext;
+
+/*
+ * ST 2084. The five literals below are deliberately the SAME five lines as the producer next door
+ * (libavfilter/vf_hdr10plus.c:90-94) - two hand-written copies of the standard's numbers are how
+ * two files drift apart, so the numeric gate asserts they stay textually identical rather than
+ * merely equivalent. Research report 92 measured this set against the standard's own anchor points:
+ * 0.5081 -> 100.0 cd/m2, 0.7515 -> 997.0, 1.0 -> 10000.0, monotone across all 4096 codes, and
+ * eotf(oetf(x)) worst-case 7.31e-07, which is the documented PQ black platform (c1^m2), not slop.
+ */
+#define PQ_M1 (2610.0 / 16384.0)
+#define PQ_M2 (2523.0 / 4096.0 * 128.0)
+#define PQ_C1 (3424.0 / 4096.0)
+#define PQ_C2 (2413.0 / 4096.0 * 32.0)
+#define PQ_C3 (2392.0 / 4096.0 * 32.0)
+
+/*
+ * The EOTF on a NORMALISED code: 1.0 in means 1.0 out == the PQ full scale (10000 cd/m2). The
+ * producer's own pq_eotf() takes integer codes and returns nits, which is the right shape for
+ * measuring and the wrong one here, where the answer goes straight into a matrix. Same numerator
+ * and denominator layout, and the same two guards: the producer returns 0 for a non-positive
+ * denominator (vf_hdr10plus.c:179-180), and a negative numerator is not a negative light level but
+ * a code under the black platform, so it clamps to 0 too.
+ */
+static double dovi_pq_eotf_d(double e)
+{
+    double p  = pow(e > 0.0 ? e : 0.0, 1.0 / PQ_M2);
+    double nm = p - PQ_C1;
+    double de = PQ_C2 - PQ_C3 * p;
+
+    if (de <= 0.0 || nm <= 0.0)
+        return 0.0;
+    return pow(nm / de, 1.0 / PQ_M1);
+}
+
+/* The analytic inverse of the function above, so the round trip can be asserted instead of
+ * assumed. Clamped to [0,1] on the way in, like the Python route the numeric gate compares with. */
+static double dovi_pq_oetf_d(double lin)
+{
+    double x = lin < 0.0 ? 0.0 : (lin > 1.0 ? 1.0 : lin);
+    double p = pow(x, PQ_M1);
+
+    return pow((PQ_C1 + PQ_C2 * p) / (1.0 + PQ_C3 * p), PQ_M2);
+}
+
+/*
+ * Invert a row-major 3x3 by its adjugate, or refuse it.
+ *
+ * The refusal is the load-bearing part. A singular matrix yields infinities, llround() turns those
+ * into *some* integer, and the picture that comes out still serialises and still decodes - which is
+ * the failure shape this filter refuses everywhere else. |det| is compared against an absolute
+ * 1e-12, which is only honest because these coefficients are rationals of order 1 (the real P5
+ * items measure det(rgb_to_lms) = 1.13169236936): under that, the matrix itself is degenerate
+ * rather than merely small.
+ *
+ * The closed form is checked by a fixture that can actually see an orientation error. The real P5
+ * items' matrix is symmetric, so its inverse is symmetric too and a transposed cofactor agrees
+ * with it to the last bit - the first version of this comment claimed exactly that kind of
+ * agreement, from a comparison that could not have failed. The probe host therefore inverts an
+ * ASYMMETRIC matrix as well and multiplies back: worst residual 6.9e-18 there
+ * (test_dovi_p5_host.c, p5probe/p5-c-probe-20261002.log), and 2.2e-16 on the symmetric one - and
+ * that fixture is what caught the transposed term this comment is now describing.
+ */
+static int dovi_invert3(const AVRational in[9], double out[9])
+{
+    double a[9];
+    double det;
+    int i;
+
+    for (i = 0; i < 9; i++)
+        a[i] = av_q2d(in[i]);
+
+    det = a[0] * (a[4] * a[8] - a[5] * a[7])
+        - a[1] * (a[3] * a[8] - a[5] * a[6])
+        + a[2] * (a[3] * a[7] - a[4] * a[6]);
+    if (!(fabs(det) > 1e-12))
+        return AVERROR_INVALIDDATA;
+
+    out[0] = (a[4] * a[8] - a[5] * a[7]) / det;
+    out[1] = (a[2] * a[7] - a[1] * a[8]) / det;
+    out[2] = (a[1] * a[5] - a[2] * a[4]) / det;
+    out[3] = (a[5] * a[6] - a[3] * a[8]) / det;
+    out[4] = (a[0] * a[8] - a[2] * a[6]) / det;
+    out[5] = (a[2] * a[3] - a[0] * a[5]) / det;
+    out[6] = (a[3] * a[7] - a[4] * a[6]) / det;
+    out[7] = (a[1] * a[6] - a[0] * a[7]) / det;
+    out[8] = (a[0] * a[4] - a[1] * a[3]) / det;
+    return 0;
+}
+
+/*
+ * ------------------------------------------------------------------ clause 5.4.3.2: the EL residual
+ *
+ * The NLQ pre-fold. Clause 5.4.3.2 dequantises each EL sample against the RPU's per-component
+ * (nlq_offset, linear_deadzone_slope S, linear_deadzone_threshold T), bounded by fp_hdr_in_max R,
+ * and divides by 2**coefficient_log2_denom. The three formulas below are that fold, and they are
+ * deliberately the SAME three lines the shipped Python reference uses (dv_ycc.nlq_params):
+ *
+ *     offset    = nlq_offset / (2**el_bit_depth - 1)
+ *     slope     = (2**el_bit_depth - 1) * S / 2**coef_log2_denom
+ *     threshold = (T - 0.5 * S) / 2**coef_log2_denom
+ *     ceiling   = R / 2**coef_log2_denom
+ *
+ * `-0.5 * S` is not a fudge: it is the half-sample the clause's `<< 1; -= sign` zig-zag implies,
+ * and the kit's own mutation arm measured it moving real residuals, so it is live rather than
+ * decorative. `R` is a CEILING and not a factor - clause 5.4.3.2's own pseudo-code uses it exactly
+ * three times, all of them `RR = R << (10 - EL_bit_depth + 1)` and the two-sided bound that
+ * follows. The one shipped reference implementation never multiplies by it at all.
+ *
+ * WHY THE RESIDUAL IS ADDED IN THE CURVE-OUTPUT DOMAIN
+ * Clause 5.4.3.1: the reconstruction "adds the inverse quantized EL signal to the MAPPED BL
+ * signal". Mapped - i.e. after the reshaping curve, and before the DM's Y'CbCr->RGB matrix and
+ * before the PQ EOTF. libplacebo runs the same order in one place: src/shaders/colorspace.c:337-338
+ * reshapes, :346 composes the NLQ residual, and only then :350 runs pl_color_repr_decode, the
+ * matrix. Getting this order wrong does not produce a visible failure - the frame still
+ * serialises, still decodes and still gets a full set of ST 2094-40 values - which is exactly the
+ * failure shape this filter refuses everywhere else, and exactly why the test host that drives this
+ * arithmetic compares against the Python reference sample for sample instead of checking that a
+ * file came out.
+ *
+ * The shift amounts are the clause's, and two of them make the clause inexecutable on some inputs
+ * rather than merely awkward - dovi_nlq_unsupported() below names them instead of clamping them
+ * away, because "shifting by a negative amount" has no meaning to fall back on.
+ */
+static int dovi_nlq_predicates_ok(const AVDOVIRpuDataHeader *hdr)
+{
+    /* 5.4.3.2's `<< (10 - EL_bit_depth)` and `R << (10 - EL_bit_depth + 1)` both go negative above
+     * this: at EL_bit_depth == 12 the second is -1, which is undefined behaviour in C and has no
+     * meaning in the clause's arithmetic either. FFmpeg's own parser accepts the field, so the
+     * refusal has to live here rather than in the parse. */
+    if (hdr->el_bit_depth > 10)
+        return 0;
+    /* The final `>> (coefficient_log2_denom - 5 - EL_bit_depth)` is the other one. */
+    if (hdr->coef_log2_denom - 5 - hdr->el_bit_depth < 0)
+        return 0;
+    return 1;
+}
+
+static void dovi_nlq_fold(const AVDOVIRpuDataHeader *hdr, const AVDOVIDataMapping *map,
+                          double off[3], double slope[3], double threshold[3], double ceiling[3])
+{
+    const double el_scale = 1.0 / ((1 << hdr->el_bit_depth) - 1);
+    const double coef     = 1.0 / (double)(1ULL << hdr->coef_log2_denom);
+    const double slope_sc = ((1 << hdr->el_bit_depth) - 1) * coef;
+    int c;
+
+    for (c = 0; c < 3; c++) {
+        const double S = (double) map->nlq[c].linear_deadzone_slope;
+        const double T = (double) map->nlq[c].linear_deadzone_threshold;
+
+        off[c]       = el_scale * (double) map->nlq[c].nlq_offset;
+        slope[c]     = slope_sc * S;
+        threshold[c] = coef * (T - 0.5 * S);
+        ceiling[c]   = coef * (double) map->nlq[c].vdr_in_max;
+    }
+}
+
+/*
+ * One sample of clause 5.4.3.2 plus the addition clause 5.4.3.3 asks for.
+ *
+ * `el_norm` is the EL sample in ITS OWN normalised domain; the return value is the residual in the
+ * SAME domain the curve output lives in, ready to be added to it.
+ *
+ * `sign(cen) == 0` at `cen == 0` is the load-bearing branch, not an optimisation: it is the
+ * clause's `if (rr == 0) { r = 0; }` carve-out, and it is what makes a fully neutral EL add exactly
+ * nothing - a property the kit's own Python suite asserts with array_equal rather than a tolerance.
+ * A port that writes this as `<=` or `<`, or that lets the zig-zag turn 0 into +/-1, keeps every
+ * other sample right and breaks only this one, which is why the negative control below perturbs the
+ * input by one code: without that arm, "the neutral EL changed nothing" is also what a compose that
+ * never ran would report.
+ */
+static double dovi_nlq_residual_1(double el_norm, double offset, double slope, double threshold,
+                                  double ceiling)
+{
+    const double cen = el_norm - offset;
+    double r;
+
+    if (cen == 0.0)
+        return 0.0;
+
+    r = (cen < 0.0 ? -1.0 : 1.0) * (fabs(cen) * slope + threshold);
+    if (r > ceiling)
+        r = ceiling;
+    if (r < -ceiling)
+        r = -ceiling;
+    return r;
+}
+
+/*
+ * The EL's own per-component coded median, as the `el_neutral=coded-median` diagnostic arm wants it.
+ *
+ * Read off the EL plane the caller handed in, at the EL's own raster, normalised the same way
+ * dovi_nlq_residual_1 normalises its input - so the two candidates it is being compared against
+ * (this and the RPU's declared nlq_offset) are in the same units and the difference means something.
+ *
+ * The median is taken on a fixed stride rather than over every sample of the plane: a 4K plane is
+ * 8.3 million samples and this value is a per-frame diagnostic, so an exact median would cost a
+ * full histogram to answer a question that a bounded sample answers to the same code. `step` is
+ * chosen so at most DOVI_EL_MEDIAN_SAMPLES samples are read, and the count actually read is what
+ * the caller logs - a diagnostic that hid its own sample count would be a worse instrument than no
+ * diagnostic at all.
+ */
+#define DOVI_EL_MEDIAN_SAMPLES 65536
+
+static double dovi_el_median_1(const uint16_t *plane, ptrdiff_t stride, int w, int h, int bit_depth,
+                               long long *sampled)
+{
+    enum { HIST = 1 << 10 };   /* 10-bit EL is the only depth clause 5.4.3.2 executes (see above) */
+    uint16_t *vals;
+    long long n = 0, i, total = (long long) w * h, step, want;
+    double med = 0.0;
+
+    *sampled = 0;
+    if (w <= 0 || h <= 0 || bit_depth > 10)
+        return 0.0;
+    want = total < DOVI_EL_MEDIAN_SAMPLES ? total : DOVI_EL_MEDIAN_SAMPLES;
+    if (want <= 0)
+        return 0.0;
+    step = total / want;
+    if (step < 1)
+        step = 1;
+    vals = av_malloc_array((size_t) want + 1, sizeof(*vals));
+    if (!vals)
+        return 0.0;
+    for (i = 0; i < total && n <= want; i += step) {
+        const int x = (int)(i % w), y = (int)(i / w);
+        const unsigned v = plane[(ptrdiff_t) y * stride + x];
+
+        vals[n++] = (uint16_t) (v < (1u << bit_depth) ? v : (1u << bit_depth) - 1);
+    }
+    if (!n) {
+        av_free(vals);
+        return 0.0;
+    }
+    {
+        /* An insertion sort over at most 65536 uint16 is O(n^2) and would be the wrong thing to
+         * write; HIST buckets are O(n) and exact for a value range the EL's depth bounds. */
+        long long hist[HIST];
+        long long seen = 0, half = (n + 1) / 2;
+        int b;
+
+        memset(hist, 0, sizeof(hist));
+        for (i = 0; i < n; i++)
+            hist[vals[i] < HIST ? vals[i] : HIST - 1]++;
+        for (b = 0; b < HIST; b++) {
+            seen += hist[b];
+            if (seen >= half) {
+                med = (double) b;
+                break;
+            }
+        }
+        *sampled = n;
+    }
+    av_free(vals);
+    return med / (double) ((1 << bit_depth) - 1);
+}
+
+/*
+ * The arithmetic is deliberately in a function with no filtergraph state in it,
+ * so it can be called - and therefore checked - outside a graph. The HDR10+
+ * producer next to it was only found to divide by zero on the first frame
+ * because a harness could call its per-frame code directly.
+ *
+ * src[] is the base layer's own component planes in its own coded domain, which filter_frame()
+ * has already checked against the RPU's declared bl_bit_depth; dst[] receives planar R, G, B in
+ * the PQ code domain of `out_depth` bits - the depth of the buffer it was handed, which the
+ * graph negotiates and is NOT necessarily the input's. The chain is the one the curves are
+ * defined for: curve per component in the coded domain, then the DM's own Y'CbCr->RGB matrix,
+ * which dovi_meta.h documents as acting "before PQ linearization". Emitting PQ codes rather than
+ * linear light is what lets the producer filter measure them, since it applies the ST 2084 EOTF
+ * itself as ST 2094-40 4.4 requires.
+ *
+ * An ICtCp base layer (Profile 5) takes the same curves and the same subtract-then-matrix step -
+ * dovi_meta.h:176-183 documents those coefficients as the "custom Dolby Vision IPT-PQ matrices",
+ * to be used INSTEAD of what the frame's colourspace tags would give, so for P5 the matrix product
+ * lands in L'M'S' rather than in RGB' - and then two steps the Y'CbCr path has no equivalent of:
+ * the declared transfer slot, and the inverse of the DM's rgb_to_lms_matrix to get back to linear
+ * RGB. `p5_transfer` is what decides the first; passing anything other than a declared value with
+ * signal_color_space == 2 is refused here rather than guessed, and passing a declared value on a
+ * stream that is NOT ICtCp is refused too, because that is a mistake about which picture is in
+ * hand. The output stays PQ codes either way: the consumer downstream is the same one.
+ *
+ * WHY p5_transfer / el_rebuild / el_neutral ARE `int` AND NOT THEIR ENUMS
+ * Every one of them carries -1 as "the caller has not declared", and an enum whose enumerators are
+ * all non-negative may be given an UNSIGNED underlying type by the compiler. Handing `-1` to an
+ * enum-typed parameter then turns it into a huge positive number, so the very comparison that is
+ * supposed to detect an undeclared option (`x >= 0`) fires on it instead - the option is treated as
+ * DECLARED, and the refusal that exists to stop a guess never runs. That was measured here, not
+ * theorised: passing (enum P5Transfer)-1 through this parameter made the p5 branch take the
+ * "declared on a non-ICtCp stream" refusal on a frame that had declared nothing. The AVOption layer
+ * already stores these as int64, so `int` is also the type they actually arrive in.
+ *
+ * A dual-layer frame (disable_residual_flag == 0) gets one more step, and the reason it is here
+ * rather than in a filter of its own is that the step has to land BETWEEN two statements that
+ * already live in this loop: after the curve writes resh[3] and before the matrix reads it. See
+ * dovi_compose_el() for the ordering argument.
+ */
+/*
+ * ------------------------------------------------------------------ the EL -> BL raster step
+ *
+ * THIS IS A STAND-IN, AND IT HAS TO BE CALLED ONE.
+ *
+ * CCM 001 clause 5.4.1 says, in the standard's own words, "Resampling is not a normative part of
+ * the present document and is assumed to be performed prior to the" process it defines. So the
+ * standard that defines the residual does not define how a differently-sized EL gets onto the BL
+ * grid, and `el_spatial_resampling_filter_flag` does not fill the gap: it is ONE BIT, not a
+ * selector, so it names a decision the stream does not carry. The two other implementations read
+ * agree by construction - both treat that flag as a profile test rather than a filter selector.
+ *
+ * What is offered here is therefore the exact integer ratio and nothing else:
+ *   EL smaller -> each EL sample is replicated over its BL cell (repeat)
+ *   EL larger  -> every n-th sample is taken, counting from the top-left (decimation)
+ * Both keep the phase a DECLARATION rather than an invention: the caller chose the direction by
+ * naming the option, and the phase is fixed and documented (top-left) rather than fitted to the
+ * picture. A non-integer ratio is refused outright, because there the phase really would be
+ * invented and documenting it would not turn it into a reading of the bitstream.
+ *
+ * Annex B.3 of CCM 001 does publish a reference upsampler, and it is deliberately NOT implemented
+ * here. It is INFORMATIVE - a worked example, not a requirement - and it covers only the UPSAMPLING
+ * direction: every tap in it is written r[2n] / r[2n+1], and it contains no decimation filter at
+ * all. Wiring it under the name `annexb` would put a filter the standard marks informative exactly
+ * where a reader expects the normative one, and the honest description of this arm would not change.
+ * It is left for the stage that can also state what it is and is not.
+ *
+ * Returns a positive 1 for the identity case (the caller indexes 1:1), 0 when el_px[] has been
+ * filled, or a negative AVERROR when the DECLARATION does not match the material. The mismatch is
+ * EINVAL and not ENOTSUP on purpose: the material is fine, the declaration is wrong, and the two
+ * have to stay distinguishable in a log - the same split the ICtCp branch already uses.
+ */
+static int dovi_el_cell(const DoviElInput *el, int bl_w, int bl_h, enum ElRebuild how,
+                        int el_x, int el_y, int *sx, int *sy)
+{
+    int ry, rx;
+
+    if (el->width == bl_w && el->height == bl_h) {
+        /* The conformant shape, and the only one with a clause behind it (5.2.2 a). Declaring a
+         * rescale here would be a declaration about material that does not need one. */
+        if (how != EL_REBUILD_IDENTITY)
+            return AVERROR(EINVAL);
+        return 1;                              /* identity: the caller indexes 1:1 */
+    }
+
+    if (el->width < bl_w && el->height < bl_h) {
+        if (how != EL_REBUILD_REPEAT)
+            return AVERROR(EINVAL);
+        if (bl_w % el->width || bl_h % el->height)
+            return AVERROR(ENOTSUP);
+        rx = bl_w / el->width;
+        ry = bl_h / el->height;
+        *sx = el_x / rx;
+        *sy = el_y / ry;
+        return 0;
+    }
+    if (el->width > bl_w && el->height > bl_h) {
+        if (how != EL_REBUILD_DECIMATE)
+            return AVERROR(EINVAL);
+        if (el->width % bl_w || el->height % bl_h)
+            return AVERROR(ENOTSUP);
+        *sx = el_x * (el->width / bl_w);
+        *sy = el_y * (el->height / bl_h);
+        return 0;
+    }
+    /* One axis larger and the other smaller: no integer ratio describes that, and picking a
+     * direction would be the invention this branch exists to refuse. */
+    return AVERROR(ENOTSUP);
+}
+
+/* One component's residual at one BL pixel, in the curve-output domain. `*res` is written only on
+ * return 0. A negative return is a shape clause 5.4.3.2 cannot execute on (el_bit_depth > 10, or a
+ * negative denominator shift) and is refused rather than clamped into range. */
+static int dovi_el_residual_at(const DoviElInput *el, int c, int bl_w, int bl_h, int el_x, int el_y,
+                               enum ElRebuild how, double neutral, double slope, double threshold,
+                               double ceiling, int el_bd, double *res)
+{
+    const double el_scale = 1.0 / ((1 << el_bd) - 1);
+    int sx = 0, sy = 0, ident;
+    unsigned code;
+    double el_norm, cen, r;
+
+    *res = 0.0;
+
+    ident = dovi_el_cell(el, bl_w, bl_h, how, el_x, el_y, &sx, &sy);
+    if (ident < 0)
+        return ident;
+    if (!ident && (sx < 0 || sx >= el->width || sy < 0 || sy >= el->height))
+        return AVERROR_INVALIDDATA;
+
+    /* `sx`/`sy` are in the LUMA raster; component c may live on a smaller one. Scaling here rather
+     * than inside dovi_el_cell keeps the geometry decision (one mapping, one refusal) separate from
+     * the per-component addressing, and makes the subsampling explicit at the one place that reads
+     * a plane. A 4:2:0 chroma plane is half resolution in BOTH directions, so both axes scale. */
+    if (c) {
+        int cw = el->chroma_w > 0 ? el->chroma_w : el->width;
+        int ch = el->chroma_h > 0 ? el->chroma_h : el->height;
+
+        if (cw != el->width)
+            sx = sx * cw / el->width;
+        if (ch != el->height)
+            sy = sy * ch / el->height;
+        if (sx >= cw)
+            sx = cw - 1;
+        if (sy >= ch)
+            sy = ch - 1;
+    }
+    if (sx < 0 || sy < 0)
+        return AVERROR_INVALIDDATA;
+
+    code = (unsigned) el->plane[c][(ptrdiff_t) sy * el->stride[c] + sx];
+    el_norm = (double) code * el_scale;
+    cen = el_norm - neutral;
+    /* Clause 5.4.3.2's `if (rr == 0) { r = 0; }` carve-out. Load-bearing, not an optimisation: it
+     * is what makes a fully neutral EL add exactly nothing, and the kit's own Python suite asserts
+     * that with array_equal rather than a tolerance. Writing it as `<=` or `<`, or letting a
+     * zig-zag turn 0 into +/-1, leaves every other sample right and breaks only this one. */
+    if (cen == 0.0)
+        return 0;
+    r = (cen < 0.0 ? -1.0 : 1.0) * (fabs(cen) * slope + threshold);
+    /* `ceiling` is fp_hdr_in_max and it is a CEILING: clause 5.4.3.2's pseudo-code uses R exactly
+     * three times, all of them `RR = R << ...` and the two-sided bound that follows. It is never a
+     * factor and never a divisor. */
+    if (r > ceiling)
+        r = ceiling;
+    if (r < -ceiling)
+        r = -ceiling;
+    *res = r;
+    return 0;
+}
+
+/*
+ * ------------------------------------------------------------------ the EL compose, one triple
+ *
+ * Called once per pixel, from inside dovi_apply_planes()'s pixel loop, between the curve writing
+ * resh[3] and the matrix reading it. That position IS the specification: clause 5.4.3.1 says the
+ * reconstruction "adds the inverse quantized EL signal to the MAPPED BL signal" - mapped, i.e. the
+ * curve's output - and clause 5.4.3.3's `v` is that same already-reshaped sample.
+ *
+ * The alternative placements are not obviously wrong from the outside, which is why this comment is
+ * long: adding to `mid[]` (after the matrix) or to `lin[]` (after the EOTF) still produces a frame
+ * that serialises, decodes, and carries a complete set of ST 2094-40 values, and the one counter
+ * that could have noticed - `out_of_range` - counts the CURVE's own domain and does not move in
+ * either case. No downstream measurement in this kit can separate the three, so the acceptance for
+ * this step is a sample-for-sample comparison against the Python reference, not a file that came
+ * out.
+ */
+static int dovi_compose_el(const DoviElInput *el, int bl_w, int bl_h, int el_x, int el_y,
+                           enum ElRebuild how, enum ElNeutral neutral_kind, int el_bd,
+                           const AVDOVIRpuDataHeader *hdr, const AVDOVIDataMapping *map,
+                           const double el_median[3], double resh[3], int *out_of_range)
+{
+    const double el_scale = 1.0 / ((1 << el_bd) - 1);
+    const double coef     = 1.0 / (double)(1ULL << hdr->coef_log2_denom);
+    const double slope_sc = ((1 << el_bd) - 1) * coef;
+    int c;
+
+    for (c = 0; c < 3; c++) {
+        const double S = (double) map->nlq[c].linear_deadzone_slope;
+        const double T = (double) map->nlq[c].linear_deadzone_threshold;
+        /* `el_neutral` picks WHICH level counts as zero: the RPU's declared nlq_offset (the format's
+         * own answer, since the clause's own rr is `e - nlq_offset`) or the EL's coded median (a
+         * diagnostic - see the enum's comment for why it must not ship). The residual formula is one
+         * function either way, which is the point: what changes is the input, not the arithmetic. */
+        const double neutral = (neutral_kind == EL_NEUTRAL_MEDIAN)
+                             ? el_median[c]
+                             : el_scale * (double) map->nlq[c].nlq_offset;
+        const double slope     = slope_sc * S;
+        const double threshold = coef * (T - 0.5 * S);
+        const double ceiling   = coef * (double) map->nlq[c].vdr_in_max;
+        double r;
+        int c_rc;
+
+        /* hdr->disable_residual_flag is NOT re-tested here. Clause 5.4.3.3 makes it a condition on
+         * adding r at all, and the caller reaches this function only when the residual is live;
+         * testing it in two places is how one of them ends up disagreeing with the other. */
+        c_rc = dovi_el_residual_at(el, c, bl_w, bl_h, el_x, el_y, how, neutral, slope, threshold,
+                                   ceiling, el_bd, &r);
+        if (c_rc < 0)
+            return c_rc;
+        resh[c] += r;
+        /* Counted against the same [0,1] the curve half uses, and counted at all because the
+         * residual can push a sample out of the display's range where the curve alone did not. */
+        if (!(resh[c] >= 0.0 && resh[c] <= 1.0))
+            (*out_of_range)++;
+    }
+    return 0;
+}
+
+static int dovi_apply_planes(const AVDOVIMetadata *dovi,
+                             const uint16_t *const src[3], const ptrdiff_t src_stride[3],
+                             uint16_t *const dst[3], const ptrdiff_t dst_stride[3],
+                             int width, int height, int out_depth,
+                             enum ChromaRebuild chroma, int p5_transfer,
+                             const DoviElInput *el, int el_rebuild,
+                             int el_neutral, const DoviReshOverride *resh_override,
+                             void *log_ctx, int *out_of_range)
+{
+    const AVDOVIRpuDataHeader *hdr = av_dovi_get_header(dovi);
+    const AVDOVIDataMapping   *map = av_dovi_get_mapping(dovi);
+    const AVDOVIColorMetadata *col = av_dovi_get_color(dovi);
+    const double scale_in  = 1.0 / ((1 << hdr->bl_bit_depth) - 1);
+    /* The OUTPUT domain is the buffer this function writes, not the frame it read. Those are the
