+                v += inv_rlms[3 * c + i] * lin[i];
+            dst[gbrp_plane[c]][(ptrdiff_t)y * dst_stride[gbrp_plane[c]] + x] =
+                (uint16_t)llround(dovi_pq_oetf_d(v) / scale_out);
+        }
+    }
+                }
+            }
+        }
+    }
+
+fail:
+    for (i = 0; i < 3; i++)
+        if (lut[i])
+            av_freep(&lut[i]);
+    return ret;
+}
+
+
+/*
+ * One component's curve, evaluated at a normalised input, with the same expressions
+ * dovi_apply_planes() uses per pixel: input clamped to [0,1], piece selected by the pivots in the
+ * base layer's own coded domain, coefficients divided by 2**coef_log2_denom. It exists only so the
+ * placeholder check below can read a curve without going near the reshape path, whose numeric
+ * contract is asserted elsewhere and must not move by one rounding. Nothing here writes a plane;
+ * ab/bb/cb are the probe's own input, which drives all three components with one value.
+ */
+static int dovi_curve_at(const AVDOVIReshapingCurve *cv, double x, double scale_in,
+                         double scale_c, double *out)
+{
+    const double xin = av_clipd(x, 0.0, 1.0);
+    const double ab = xin, bb = xin, cb = xin;
+    double v = 0.0;
+    int piece = 0, c;
+
+    for (c = 1; c < cv->num_pivots - 1; c++)
+        if (xin >= cv->pivots[c] * scale_in)
+            piece = c;
+    if (piece >= AV_DOVI_MAX_PIECES)
+        return AVERROR_INVALIDDATA;
+
+    switch (cv->mapping_idc[piece]) {
+    case AV_DOVI_MAPPING_POLYNOMIAL: {
+        const int64_t *k = cv->poly_coef[piece];
+
+        if (cv->poly_order[piece] < 1 || cv->poly_order[piece] > 2)
+            return AVERROR_INVALIDDATA;
+        v = ((double)k[2] * xin + (double)k[1]) * xin + (double)k[0];
+        v *= scale_c;
+        break;
+    }
+    case AV_DOVI_MAPPING_MMR: {
+        const int order = cv->mmr_order[piece];
+        double mono[7];
+        double acc = 0.0;
+        int j, m, pw;
+        double pow_tab[7][4];
+
+        if (order < 1 || order > 3)
+            return AVERROR_INVALIDDATA;
+        mono[0] = ab;  mono[1] = bb;  mono[2] = cb;
+        mono[3] = ab * bb;  mono[4] = ab * cb;  mono[5] = bb * cb;
+        mono[6] = ab * bb * cb;
+        for (m = 0; m < 7; m++) {
+            pow_tab[m][0] = 1.0;
+            for (pw = 1; pw <= 3; pw++)
+                pow_tab[m][pw] = pow_tab[m][pw - 1] * mono[m];
+        }
+        for (j = 0; j < order; j++)
+            for (m = 0; m < 7; m++)
+                acc += (double)cv->mmr_coef[piece][j][m] * pow_tab[m][j + 1];
+        v = ((double)cv->mmr_constant[piece] + acc) * scale_c;
+        break;
+    }
+    default:
+        return AVERROR_INVALIDDATA;
+    }
+
+    *out = v;
+    return 0;
+}
+
+#define DOVI_CURVE_PROBE_POINTS 257
+#define DOVI_CURVE_MIN_SPAN     1e-3
+
+/*
+ * A curve whose whole image is one value is a placeholder, not a tone map. Applying one does not
+ * fail: every pixel comes out the same, the producer downstream measures a flat picture, and the
+ * block serialises and decodes perfectly - which is why nothing after this filter could have told.
+ * The validated Python kernel this filter mirrors refuses exactly this (p5_applier.py:129-138: 257
+ * points across the component's own pivot range, refuse when max - min < 1e-3), and it measures it
+ * on real material rather than on a hypothesis: 30 of 60 frames on one clip, 31 of 60 on another.
+ *
+ * The grid is the pivots, not the frame - the curve is a function of the RPU alone - so this is
+ * 3 * 257 evaluations of a polynomial or a small MMR: no allocation, no per-pixel cost, and the
+ * same answer for every frame carrying that RPU. A real tone map spans most of the code range
+ * (every usable curve in those three clips measured >= 0.54) and the placeholders measured 0.0, so
+ * the threshold does not sit near anything it could plausibly mis-fire on.
+ *
+ * Returns 1 and names the component when a curve is flat, 0 when all three have span, and a
+ * negative error for a curve that cannot be evaluated at all - the same AVERROR_INVALIDDATA the
+ * per-pixel path already returns for those, so no new failure style is added here.
+ */
+static int dovi_apply_probe_curves(const AVDOVIMetadata *dovi, int *offender,
+                                   double *value, double *span)
+{
+    const AVDOVIRpuDataHeader *hdr = av_dovi_get_header(dovi);
+    const AVDOVIDataMapping   *map = av_dovi_get_mapping(dovi);
+    const double scale_in = 1.0 / ((1 << hdr->bl_bit_depth) - 1);
+    const double scale_c  = 1.0 / (double)(1ULL << hdr->coef_log2_denom);
+    int i, n, ret;
+
+    *offender = -1;
+    *value = 0.0;
+    *span = 0.0;
+
+    if (hdr->bl_bit_depth < 8 || hdr->bl_bit_depth > 16 ||
+        hdr->coef_log2_denom > 32)
+        return AVERROR_INVALIDDATA;
+
+    for (i = 0; i < 3; i++) {
+        const AVDOVIReshapingCurve *cv = &map->curves[i];
+        double lo = 0.0, hi = 0.0, v = 0.0, vmin = 0.0, vmax = 0.0, first = 0.0;
+
+        if (cv->num_pivots < 2 || cv->num_pivots > AV_DOVI_MAX_PIECES + 1)
+            return AVERROR_INVALIDDATA;
+        lo = cv->pivots[0] * scale_in;
+        hi = cv->pivots[cv->num_pivots - 1] * scale_in;
+
+        for (n = 0; n < DOVI_CURVE_PROBE_POINTS; n++) {
+            const double x = lo + (hi - lo) * n / (DOVI_CURVE_PROBE_POINTS - 1);
+
+            ret = dovi_curve_at(cv, x, scale_in, scale_c, &v);
+            if (ret < 0)
+                return ret;
+            if (n == 0) {
+                vmin = vmax = first = v;
+            } else {
+                vmin = FFMIN(vmin, v);
+                vmax = FFMAX(vmax, v);
+            }
+        }
+
+        if (vmax - vmin < DOVI_CURVE_MIN_SPAN) {
+            *offender = i;
+            *value = first;
+            *span = vmax - vmin;
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+/* The chroma maths in dovi_apply_planes() is 4:2:0-specific: cw/ch and the (y >> 1, x >> 1)
+ * taps assume chroma at half resolution in BOTH directions. A 4:2:2 or 4:4:4 frame would have
+ * its chroma read from rows and columns that are not where the maths expects them, and the
+ * result serialises, decodes and looks entirely healthy while describing the wrong picture -
+ * the failure mode this filter refuses everywhere else.
+ *
+ * Those formats stay in query_formats() deliberately: if the list held only 4:2:0, the graph
+ * would silently insert a chroma conversion to get there, which is precisely the unmarked
+ * assumption this filter has an option (and no default) for. Keeping them listed means the
+ * frame arrives and is refused here, in the open, with the remedy named. */
+static int dovi_apply_chroma_is_420(const AVPixFmtDescriptor *desc)
+{
+    return desc && desc->log2_chroma_w == 1 && desc->log2_chroma_h == 1;
+}
+
+static av_cold int dovi_apply_init(AVFilterContext *ctx)
+{
+    DolbyApplyContext *s = ctx->priv;
+
+    if (s->chroma < 0 || s->chroma >= CHROMA_NB) {
+        av_log(ctx, AV_LOG_ERROR, "A chroma rebuild method must be declared: nearest and "
+               "bilinear move the percentiles that end up in the metadata, so silently "
+               "picking one would put an unmarked assumption into the output.\n");
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+static int query_formats(const AVFilterContext *ctx,
+                         AVFilterFormatsConfig **cfg_in,
+                         AVFilterFormatsConfig **cfg_out)
+{
+    static const enum AVPixelFormat src_fmts[] = {
+        AV_PIX_FMT_YUV420P10LE, AV_PIX_FMT_YUV422P10LE, AV_PIX_FMT_YUV444P10LE,
+        AV_PIX_FMT_YUV420P12LE, AV_PIX_FMT_YUV422P12LE, AV_PIX_FMT_YUV444P12LE,
+        AV_PIX_FMT_NONE
+    };
+    static const enum AVPixelFormat dst_fmts[] = {
+        AV_PIX_FMT_GBRP10LE, AV_PIX_FMT_GBRP12LE,
+        AV_PIX_FMT_NONE
+    };
+    int ret;
+
+    ret = ff_formats_ref(ff_make_pixel_format_list(src_fmts), &cfg_in[0]->formats);
+    if (ret < 0)
+        return ret;
+    return ff_formats_ref(ff_make_pixel_format_list(dst_fmts), &cfg_out[0]->formats);
+}
+
+static int filter_frame(AVFilterLink *inlink, AVFrame *frame)
+{
+    AVFilterContext *ctx = inlink->dst;
+    AVFilterLink *outlink = ctx->outputs[0];
+    DolbyApplyContext *s = ctx->priv;
+    const AVFrameSideData *sd;
+    const AVDOVIMetadata *dovi;
+    const AVDOVIRpuDataHeader *hdr;
+    const AVDOVIColorMetadata *col;
+    const AVPixFmtDescriptor *desc;
+    const AVPixFmtDescriptor *out_desc;
+    /* NULL on purpose: every refusal above the buffer allocation jumps to `fail`, which
+     * reads this pointer. Declaring it uninitialized turns each of those refusals into an
+     * access violation - found only by driving the filter through a real filtergraph. */
+    AVFrame *out = NULL;
+    const uint16_t *src[3];
+    uint16_t *dst[3];
+    ptrdiff_t src_stride[3], dst_stride[3];
+    int out_of_range = 0, ret, c, depth;
+    /* all three initialised: the probe below writes them only when it has an answer to give, and
+     * the log line reads them unconditionally. */
+    int flat_component = -1;
+    double flat_value = 0.0, flat_span = 0.0;
+
+    sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA);
+    if (!sd || sd->size < sizeof(AVDOVIMetadata)) {
+        av_log(ctx, AV_LOG_ERROR, "No Dolby Vision metadata on this frame; there is nothing "
+               "to apply. If the stream is not Dolby Vision, use the ordinary producer path.\n");
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+    dovi = (const AVDOVIMetadata *)sd->data;
+    hdr = av_dovi_get_header(dovi);
+    col = av_dovi_get_color(dovi);
+
+    /* Dual layer used to be a flat refusal, keyed on the two RPU flags below and taken whatever the
+     * caller had said. It is a branch now, entered on the SAME two flags - a stream's own shape is
+     * what decides which path is taken, never an option - but with the same two declarations the
+     * ICtCp branch below demands, and for the same reason: the flags say a residual EXISTS, they do
+     * not say where it goes or how a differently-sized EL reaches this raster.
+     *
+     * Why the refusal existed at all is still true and worth keeping in view: a dual-layer stream's
+     * base layer is not the picture - the residual alone measures 61-122% of the base layer's whole
+     * curve image - so applying it and saying nothing would describe a picture that is not there.
+     * What changed is that there is now a way to be right about it, and it is entered only when the
+     * caller has declared both halves of the answer.
+     *
+     * Three outcomes, and they must stay distinguishable:
+     *   EINVAL   - the CALLER has not said, or has said something the material contradicts.
+     *   ENOTSUP  - the caller said, and THIS STREAM is outside what this filter can carry.
+     *   (proceed) - both declared, geometry is an integer ratio this filter implements.
+     *
+     * el_spatial_resampling_filter_flag does NOT by itself force a refusal any more. It is one bit
+     * that selects a filter whose identity the stream does not carry (see dovi_el_cell()), so it
+     * cannot be resolved by refusing: it is resolved by the caller declaring `el_rebuild`. It is
+     * logged here, unmoved, because it is the field that says resampling was expected to happen. */
+    if (!hdr->disable_residual_flag) {
+        if (s->el_rebuild < 0) {
+            av_log(ctx, AV_LOG_ERROR, "This is a dual-layer stream "
+                   "(disable_residual_flag=0, el_spatial_resampling_filter_flag=%d) and "
+                   "el_rebuild was not declared. The bitstream does not say which resampling "
+                   "filter brought the enhancement layer onto this raster: "
+                   "el_spatial_resampling_filter_flag is a single bit, not a selector, and CCM 001 "
+                   "clause 5.4.1 states outright that resampling \"is not a normative part of the "
+                   "present document\". The arms are not interchangeable - on this box's measured "
+                   "material the same pair reads 1.0 codes apart under the reference upsampler and "
+                   "126.0 under an integer decimation, and both produce a picture that decodes. "
+                   "Declare el_rebuild=identity (EL and BL share a raster, the conformant shape), "
+                   "repeat (EL smaller), or decimate (EL larger). This filter will not choose one "
+                   "on your behalf.\n", hdr->el_spatial_resampling_filter_flag);
+            ret = AVERROR(EINVAL);
+            goto fail;
+        }
+        if (s->el_neutral < 0) {
+            av_log(ctx, AV_LOG_ERROR, "This is a dual-layer stream and el_neutral was not "
+                   "declared. The RPU states an nlq_offset, but the bitstream does not settle "
+                   "where the EL's ZERO residual sits on real material: the CES 00004 pair's own "
+                   "EL luma median is code 64 while the RPU declares nlq_offset=512 for all three "
+                   "components, and the two readings differ by 2.4x on the kit's own gate "
+                   "(499.7 cd/m2 against 1097.4). Declare el_neutral=nlq (the format's own "
+                   "neutral, which is what clause 5.4.3.2's `rr = e - nlq_offset` means) or "
+                   "coded-median (a DIAGNOSTIC, never a choice to ship on). This filter will not "
+                   "choose one on your behalf.\n");
+            ret = AVERROR(EINVAL);
+            goto fail;
+        }
+        if (!s->el_present) {
+            av_log(ctx, AV_LOG_ERROR, "This is a dual-layer stream (disable_residual_flag=0) and "
+                   "no enhancement layer was supplied: composing without it would emit the base "
+                   "layer and describe a picture that is not there, which is what this filter used "
+                   "to refuse outright. Supply the EL planes, or use a single-layer source.\n");
+            ret = AVERROR(ENOTSUP);
+            goto fail;
+        }
+    } else if (s->el_rebuild >= 0 || s->el_neutral >= 0 || s->el_present) {
+        /* The reverse direction, and the one that is easiest to leave out. A single-layer stream
+         * that is handed these options is not being over-served, it is being MIS-DESCRIBED: there
+         * is no residual to compose, so the declarations would be carried into a picture that never
+         * needed them. This mirrors p5_transfer's own refusal on a non-ICtCp stream, and the reason
+         * is the same one :738-740 gives - letting a declaration outvote the stream's own shape is
+         * the combination that turns a wrong picture into a plausible one. */
+        av_log(ctx, AV_LOG_ERROR, "el_rebuild/el_neutral were declared on a stream whose RPU says "
+               "disable_residual_flag=1 (el_rebuild=%d, el_neutral=%d, EL supplied=%d): there is "
+               "no enhancement layer in this stream, so those options describe a residual that "
+               "does not exist. Carrying them here is not harmless - it is a statement about a "
+               "picture nobody is looking at.\n",
+               s->el_rebuild, s->el_neutral, s->el_present);
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+    /* ICtCp used to be a flat refusal. It is a branch now, with two preconditions, and both are
+     * checkable rather than assumed: the caller has to declare which transfer fills the slot
+     * (report 42.2 measured the same frame peaking at 1833 cd/m2 under one arm and 180 under the
+     * other against that stream's own declared 1000.6 cd/m2 white, and found neither arm
+     * adjudicable), and the planes have to carry the ICtCp tag - which is what patch 0005 makes
+     * the decoder derive from the RPU. An untagged frame is NOT reinterpreted here: letting an RPU
+     * field outvote the frame's own representation is the one combination that turns a wrong
+     * picture into a plausible one, and this filter's whole refusal style exists to stop that. */
+    if (col->signal_color_space == 2) {
+        if (s->p5_transfer < 0) {
+            av_log(ctx, AV_LOG_ERROR, "ICtCp (signal_color_space=2) needs p5_transfer declared, "
+                   "as cbrt or pq: the bitstream does not say which transfer the curve output is "
+                   "linearised with, and the two arms give materially different pictures. This "
+                   "filter will not choose one on your behalf.\n");
+            ret = AVERROR(EINVAL);
+            goto fail;
+        }
+        if (frame->colorspace != AVCOL_SPC_ICTCP) {
+            av_log(ctx, AV_LOG_ERROR, "The RPU declares ICtCp but this frame is tagged "
+                   "colorspace=%d, not AVCOL_SPC_ICTCP(%d): refusing to reshape planes whose "
+                   "representation is disputed. Tag them (patch 0005 makes the decoder do it from "
+                   "the RPU) or convert them deliberately, and say which you did.\n",
+                   frame->colorspace, AVCOL_SPC_ICTCP);
+            ret = AVERROR(ENOTSUP);
+            goto fail;
+        }
+    } else if (s->p5_transfer >= 0) {
+        av_log(ctx, AV_LOG_ERROR, "p5_transfer=%d declared on a stream that is not ICtCp "
+               "(signal_color_space=%d): that option only means something for a base layer coded "
+               "in ICtCp, and carrying it onto this one would apply the LMS inverse and a second "
+               "transfer to a picture that never left Y'CbCr.\n",
+               s->p5_transfer, col->signal_color_space);
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    desc = av_pix_fmt_desc_get(frame->format);
+    if (!desc) {
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+    depth = desc->comp[0].depth;
+    if (depth != 10 && depth != 12) {
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+    /* The curves act on the base layer's OWN code domain, which the RPU declares - so a frame
+     * wider than that declaration is not a higher-quality input, it is a different number for
+     * the same pixel. Measured on this box with a 10-bit-declared clip fed through
+     * format=yuv420p12le: every normalised sample came in about four times too large, the curve
+     * output pinned at its ceiling, and the frames that came out had R = 4095 and G = 0 across
+     * two thirds of the picture with only five distinct codes in the whole frame. A downstream
+     * producer then reported maxscl = average_maxrgb = 100000/100000, which serialises and
+     * decodes perfectly. Refusing is the only answer that cannot be missed. */
+    if (depth != hdr->bl_bit_depth) {
+        av_log(ctx, AV_LOG_ERROR, "Frame is %d-bit but the RPU declares bl_bit_depth=%d: the "
+               "curves are defined on the declared domain, so reading %d-bit samples through a "
+               "1/%d divisor would scale every pixel by about %g and pin the result at the curve "
+               "ceiling. Deliver the base layer at its declared depth.\n",
+               depth, hdr->bl_bit_depth, depth, (1 << hdr->bl_bit_depth) - 1,
+               (double)((1 << depth) - 1) / ((1 << hdr->bl_bit_depth) - 1));
+        ret = AVERROR(ENOTSUP);
+        goto fail;
+    }
+    if (!dovi_apply_chroma_is_420(desc)) {
+        av_log(ctx, AV_LOG_ERROR, "Only 4:2:0 input is supported, not %s: the chroma rebuild "
+               "assumes half resolution in both directions, so this picture would be measured "
+               "against the wrong samples with nothing to show it. Convert to yuv420p10le / "
+               "yuv420p12le deliberately if that is what you want - the rebuild is part of the "
+               "result.\n", av_get_pix_fmt_name(frame->format));
+        ret = AVERROR(ENOTSUP);
+        goto fail;
+    }
+    /* --------------------------------------------- the base layer's TRANSFER: Profile 8.4
+     *
+     * PROFILE 8.1 AND PROFILE 8.4 ARE THE SAME RPU, and that is why this check exists at all.
+     * It is not a convention: `dovi_rpu.py`'s `dovi_profile()` - which mirrors dovi_tool's
+     * `rpu_data_header.rs:178` - returns 8 for EVERY `vdr_rpu_profile == 1` block that is not the
+     * dual-layer shape, and there is no field after that which separates 8.1 from 8.4. The two
+     * differ in exactly one place: the base layer's transfer, SDR for 8.1 and HLG (ARIB STD-B67)
+     * for 8.4. Measured on a real 8.4 file (`src4/dvp8/dv84.mov`) the RPU is `rpu_format 18`,
+     * `vdr_rpu_profile 1`, `disable_residual 0` - identical in kind to an 8.1 RPU.
+     *
+     * WHY IT MATTERS HERE AND NOT SOMEWHERE DOWNSTREAM. ST 2094-40 clause 4.4 defines the
+     * "linearized signal" the metadata is measured through as ST 2084, and `vf_hdr10plus` enforces
+     * that by refusing any frame whose `color_trc` is not `SMPTE2084`. So an HLG picture measured on
+     * a PQ axis yields a payload that serialises, decodes, and prints a complete plausible set of
+     * 2094-40 values - while describing a picture the decoder will never reconstruct. Nothing
+     * downstream can catch it. That is the same argument that makes the ICtCp refusal above a
+     * refusal rather than a warning.
+     *
+     * THE REMEDY ALREADY EXISTS AND IS ALREADY IN THE SERIES: `hlg2pq` (patch 0013) converts the
+     * samples and re-tags the frame PQ. What was missing was anything that NOTICES an HLG base layer
+     * and names it. Measured before this block existed: `grep -E 'ARIB|B67|HLG|hlg' vf_dovi_apply.c`
+     * returned 0 hits, so an HLG base layer travelled the whole graph unchallenged and was stopped
+     * only by the producer's message about a transfer - with nothing saying "this is Profile 8.4".
+     *
+     * THE CHECK READS THE FRAME AND ONLY THE FRAME. The transfer is not in the RPU (above), so the
+     * frame's own tag is the only witness available. It is also the honest one: a caller who has
+     * already run `hlg2pq` presents PQ here and passes with no declaration at all, so the correct
+     * path stays a one-liner and only the incorrect one reads this message.
+     *
+     * NOT APPLIED TO ICtCp. A Profile 5 base layer is full-range ICtCp with its own inverse-EOTF
+     * choice carried in `p5_transfer`, and `hlg2pq` works in the Y'CbCr domain - running it first
+     * would convert a picture that is not in that domain. The branches are mutually exclusive, and
+     * that is why this sits under `!p5`.
+     */
+    if (col->signal_color_space != 2 &&
+        frame->color_trc == AVCOL_TRC_ARIB_STD_B67) {
+        av_log(ctx, AV_LOG_ERROR,
+               "the base layer is HLG (ARIB STD-B67) - the Profile 8.4 shape. Its RPU is the same "
+               "one Profile 8.1 uses (`vdr_rpu_profile == 1` carries no 8.1/8.4 field), so the ONLY "
+               "thing that distinguishes them is this transfer, and it is not in the bitstream "
+               "metadata. HDR10+ (ST 2094-40 4.4) is measured over ST 2084, so authoring from an HLG "
+               "picture produces a payload that decodes cleanly and describes a picture the decoder "
+               "cannot reconstruct. Convert the picture first:\n"
+               "    ... ,hlg2pq=... ,hdr10plus=...\n"
+               "`hlg2pq` converts the samples and re-tags the frame PQ, after which this filter and "
+               "the producer both proceed. Refusing rather than measuring on the wrong axis, because "
+               "nothing downstream can tell the two apart.\n");
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    /* The curves are as much an input as the planes are, so a curve that maps its whole domain to
+     * one value has to be caught here rather than measured downstream: applying it emits a flat
+     * picture that serialises, decodes and prints a full set of ST 2094-40 values, and no number
+     * after this filter could tell. Same test and same numbers as the Python kernel (see
+     * dovi_apply_probe_curves), same refusal style as the checks above - and it runs before the
+     * output buffer is allocated, so `out` is still the NULL the fail path expects. */
+    ret = dovi_apply_probe_curves(dovi, &flat_component, &flat_value, &flat_span);
+    if (ret < 0)
+        goto fail;
+    if (ret > 0) {
+        av_log(ctx, AV_LOG_ERROR, "Component %d's curve maps its whole domain to %.6f (span %.1e) "
+               "over %d points of its own pivot range - a placeholder, not a tone map. Authoring "
+               "from it would emit a flat block; refusing rather than emitting it.\n",
+               flat_component, flat_value, flat_span, DOVI_CURVE_PROBE_POINTS);
+        ret = AVERROR(ENOTSUP);
+        goto fail;
+    }
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_frame_copy_props(out, frame);
+    if (ret < 0)
+        goto fail;
+
+    /* The depth this function WRITES in, read off the buffer it was given. It is checked rather
+     * than assumed because the output list offers both depths: if the graph handed back
+     * something else, `1 << out_desc->comp[0].depth` would silently describe a picture that is
+     * not the buffer. */
+    out_desc = av_pix_fmt_desc_get(out->format);
+    if (!out_desc || (out_desc->comp[0].depth != 10 && out_desc->comp[0].depth != 12)) {
+        av_log(ctx, AV_LOG_ERROR, "negotiated output %s is not a 10- or 12-bit planar RGB "
+               "buffer; refusing rather than writing codes sized for another depth into it\n",
+               av_get_pix_fmt_name(out->format));
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    /* linesize is in BYTES; the planes are walked as uint16_t, so the stride this
+     * function is handed must be in samples. Half of it, for every plane - getting
+     * this wrong is not a crash, it is row 0 correct and every row after it garbage. */
+    for (c = 0; c < 3; c++) {
+        src[c] = (const uint16_t *)frame->data[c];
+        src_stride[c] = frame->linesize[c] / 2;
+        dst[c] = (uint16_t *)out->data[c];
+        dst_stride[c] = out->linesize[c] / 2;
+    }
+
+    ret = dovi_apply_planes(dovi, src, src_stride, dst, dst_stride,
+                            outlink->w, outlink->h, out_desc->comp[0].depth,
+                            s->chroma, s->p5_transfer,
+                            s->el_present ? &s->el : NULL, s->el_rebuild, s->el_neutral,
+                            NULL, ctx, &out_of_range);
+    if (ret < 0)
+        goto fail;
+
+    /* The curves have been applied, so the DM no longer describes this picture.
+     * Removed by type on purpose: the generic colour-dependent property sweep
+     * would also strip the HDR10+ side data this filter's output is about to get. */
+    av_frame_side_data_remove(&out->side_data, &out->nb_side_data,
+                              AV_FRAME_DATA_DOVI_METADATA);
+
+    out->colorspace  = AVCOL_SPC_BT2020_NCL;
+    out->color_trc   = AVCOL_TRC_SMPTE2084;
+    out->color_primaries = AVCOL_PRI_BT2020;
+    out->color_range = AVCOL_RANGE_JPEG;
+
+    if (out_of_range)
+        av_log(ctx, AV_LOG_VERBOSE, "%d curve output value(s) fell outside [0,1] of the "
+               "target display; they were clamped by the matrix step.\n", out_of_range);
+
+    av_frame_free(&frame);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    av_frame_free(&frame);
+    if (out)
+        av_frame_free(&out);
+    return ret;
+}
+
+#define OFFSET(x) offsetof(DolbyApplyContext, x)
+#define FLAGS (AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_FILTERING_PARAM)
+
+static const AVOption dovi_apply_options[] = {
+    { "chroma", "how to rebuild chroma onto the luma grid before the matrix acts",
+      OFFSET(chroma), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, CHROMA_NB - 1, FLAGS, .unit = "chroma" },
+    { "nearest",   "replicate each chroma sample over its luma area",
+      0, AV_OPT_TYPE_CONST, { .i64 = CHROMA_NEAREST }, 0, 0, FLAGS, .unit = "chroma" },
+    { "bilinear",  "MPEG co-sited bilinear upsample",
+      0, AV_OPT_TYPE_CONST, { .i64 = CHROMA_BILINEAR }, 0, 0, FLAGS, .unit = "chroma" },
+    /* No default on purpose, and -1 is not a usable value: see the enum's comment for what the two
+     * arms measure. Unlike `chroma` this is only demanded of an ICtCp stream, because a P8 stream
+     * has no transfer slot to fill and must keep working with no new option. */
+    { "p5_transfer", "transfer to linearise an ICtCp (Profile 5) curve output with; required for "
+                     "such frames, refused for any other stream",
+      OFFSET(p5_transfer), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, P5_TRANSFER_NB - 1, FLAGS,
+      .unit = "p5_transfer" },
+    { "cbrt",   "sign(x) * |x|^3, the cube of the encoded signal",
+      0, AV_OPT_TYPE_CONST, { .i64 = P5_TRANSFER_CBRT }, 0, 0, FLAGS, .unit = "p5_transfer" },
+    { "pq",     "the ST 2084 EOTF, 1.0 == 10000 cd/m2",
+      0, AV_OPT_TYPE_CONST, { .i64 = P5_TRANSFER_PQ }, 0, 0, FLAGS, .unit = "p5_transfer" },
+    /* Same rules as p5_transfer above, and for the same reason: only a dual-layer frame consults
+     * these, so a single-layer P8 stream keeps working with no new option while a dual-layer frame
+     * is refused rather than guessed at. No default on either, and -1 is not a usable value. */
+    { "el_rebuild", "how the enhancement layer reaches the base layer's raster; required for a "
+                    "dual-layer frame, refused for any other stream. repeat and decimate are "
+                    "integer-ratio STAND-INS - the resampling filter's identity is not in the "
+                    "bitstream - and identity is the shape CCM 001 5.2.2 a) asks for",
+      OFFSET(el_rebuild), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, EL_REBUILD_NB - 1, FLAGS,
+      .unit = "el_rebuild" },
+    { "repeat",   "STAND-IN: EL smaller than BL, each EL sample replicated over its BL cell "
+                  "(phase: top-left). Not a standard; see the option's comment",
+      0, AV_OPT_TYPE_CONST, { .i64 = EL_REBUILD_REPEAT }, 0, 0, FLAGS, .unit = "el_rebuild" },
+    { "decimate", "STAND-IN: EL larger than BL, every n-th sample from the top-left. Not a "
+                  "standard, and it is not what CCM 001 Annex B.3 describes - that reference is "
+                  "informative and has no decimation filter at all",
+      0, AV_OPT_TYPE_CONST, { .i64 = EL_REBUILD_DECIMATE }, 0, 0, FLAGS, .unit = "el_rebuild" },
+    { "identity", "EL and BL share a raster, so nothing is resampled (CCM 001 5.2.2 a)",
+      0, AV_OPT_TYPE_CONST, { .i64 = EL_REBUILD_IDENTITY }, 0, 0, FLAGS, .unit = "el_rebuild" },
+    { "el_neutral", "where the enhancement layer's zero residual sits; required for a dual-layer "
+                    "frame, refused for any other stream",
+      OFFSET(el_neutral), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, EL_NEUTRAL_NB - 1, FLAGS,
+      .unit = "el_neutral" },
+    { "nlq",    "the format's own neutral: clause 5.4.3.2's rr = e - nlq_offset, with its rr == 0 "
+                "-> r = 0 carve-out",
+      0, AV_OPT_TYPE_CONST, { .i64 = EL_NEUTRAL_NLQ }, 0, 0, FLAGS, .unit = "el_neutral" },
+    { "coded-median", "DIAGNOSTIC, never a choice to ship on: the EL's own per-component coded "
+                      "median, so the disagreement with nlq_offset can be measured rather than "
+                      "argued",
+      0, AV_OPT_TYPE_CONST, { .i64 = EL_NEUTRAL_MEDIAN }, 0, 0, FLAGS, .unit = "el_neutral" },
+    { NULL }
+};
+
+/* ------------------------------------------------------------------ filter registration
+ *
+ * GUARDED, and the guard is load-bearing rather than tidiness. `vf_dovi_compose.c` composes with the
+ * SAME arithmetic this file carries - `dovi_apply_planes()`, the `DoviElInput`/`DoviReshOverride`
+ * plumbing, the two declaration enums - and reaches it by including this file, because the
+ * alternatives were both worse: a second copy of the compose would be a second implementation to
+ * keep in step (the entire point of the P1 work was that the compose has exactly one), and lifting
+ * the arithmetic into a shared translation unit would have rewritten a filter whose readings are
+ * already pinned. Including it a second time must therefore bring in the arithmetic and NOT a
+ * second definition of `ff_vf_dovi_apply` / `dovi_apply_class` / `inputs`, which is exactly what
+ * this guard prevents. It is defined by `vf_dovi_compose.c` before its include.
+ */
+#ifndef DOVI_APPLY_NO_FILTER_REGISTRATION
+
+AVFILTER_DEFINE_CLASS(dovi_apply);
+
+static const AVFilterPad inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = filter_frame,
+    },
+};
+
+const FFFilter ff_vf_dovi_apply = {
+    .p.name        = "dovi_apply",
+    .p.description = NULL_IF_CONFIG_SMALL("Apply Dolby Vision RPU reshaping curves to a base layer."),
+    .p.priv_class  = &dovi_apply_class,
+    .p.flags       = 0,
+    .priv_size     = sizeof(DolbyApplyContext),
+    .init          = dovi_apply_init,
+    FILTER_INPUTS(inputs),
+    FILTER_OUTPUTS(ff_video_default_filterpad),
+    FILTER_QUERY_FUNC2(query_formats),
+};
+
+#endif /* DOVI_APPLY_NO_FILTER_REGISTRATION */
