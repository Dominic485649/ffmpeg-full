+const FFFilter ff_vf_dovi_compose = {
+    .p.name         = "dovi_compose",
+    .p.description  = NULL_IF_CONFIG_SMALL("Compose a Dolby Vision enhancement layer onto its base "
+                                           "layer (ETSI GS CCM 001 5.4.3.2/5.4.3.3)."),
+    .p.priv_class   = &dovi_compose_class,
+    /*
+     * `AVFILTER_FLAG_HWDEVICE` IS ABSENT AND MUST STAY ABSENT; the substantive point is that this
+     * filter must not be slice-threaded, and the way to say that is to NOT set
+     * `AVFILTER_FLAG_SLICE_THREADS` (slice threading is opt-in here - avfilter.h:166 - and
+     * vf_framepack.c, the closest two-input activate() filter, sets no flags at all).
+     *
+     * MEASURED, and this is the crash this filter had for a whole debugging round:
+     *   two HEVC inputs + dovi_compose, default threads      -> 0xC0000005 (NULL WRITE, thread T34)
+     *   two HEVC inputs + dovi_compose, -threads 1
+     *                                   -filter_threads 1   -> rc=0, frame produced
+     *   two lavfi inputs + dovi_compose                     -> reaches its own refusal, no crash
+     *   two HEVC inputs + a stock 2-input filter            -> rc=0
+     * The third and fourth lines are what isolate it: the fault needs HEVC-decoded frames AND this
+     * filter, and it disappears when the graph is single-threaded. Per-pad queues mutated from
+     * several workers is exactly that shape.
+     *
+     * WHY THE FLAG ALONE DID NOT FIX IT, recorded so the next reader does not repeat the attempt:
+     * leaving SLICE_THREADS unset stops the FILTERGRAPH from slicing this filter's body, but the
+     * crash is driven by the graph running at all - `-filter_complex_threads 1` on its own still
+     * faults, while `-threads 1 -filter_threads 1` does not. So the operator-facing answer is to run
+     * the graph single-threaded, and the filter-side answer is the queue access being safe under the
+     * framework's threading model; that second half is what remains to be done (see the P2 record).
+     */
+    .priv_size      = sizeof(DoviComposeContext),
+    .init           = dovi_compose_init,
+    .uninit         = dovi_compose_uninit,
+    .activate       = dovi_compose_activate,
+    FILTER_INPUTS(dovi_compose_inputs),
+    FILTER_OUTPUTS(dovi_compose_outputs),
+    FILTER_QUERY_FUNC2(dovi_compose_query_formats),
