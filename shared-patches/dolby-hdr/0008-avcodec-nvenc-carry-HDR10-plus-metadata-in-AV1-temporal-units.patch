+#if CONFIG_AV1_NVENC_ENCODER
+/* HDR10+ (SMPTE ST 2094-40) reaches an AV1 elementary stream as an OBU_METADATA of
+ * AV1_METADATA_TYPE_ITUT_T35. The six identity bytes in front of the ST 2094-40 body come from
+ * "HDR10+ AV1 Metadata Handling Specification" v1.0.1, section 2.1; av_dynamic_hdr_plus_to_t35()
+ * serialises the body only, so the carrier writes the identity itself - the same split upstream's
+ * own libaom wrapper makes. Written as plain stores rather than bytestream_put_byte()/put_be16():
+ * this header has a fixed length with no bounds logic to gain, and each macro's unchecked pointer
+ * arithmetic is separately diagnosed under /W3 by MSVC. */
+#define HDR10PLUS_T35_HEADER_SIZE 6
+
+/* Build the whole metadata OBU for one picture: header byte, LEB128 size, metadata_type, the six
+ * identity bytes, the ST 2094-40 body and obu_trailing_bits. *out stays NULL when the frame carries
+ * no HDR10+ side data, which is the normal case and costs nothing. */
+static int nvenc_av1_hdr10plus_obu(AVCodecContext *avctx, const AVFrame *frame,
+                                   AVBufferRef **out)
+{
+    AVFrameSideData *sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+    AVDynamicHDRPlus *hdr_plus;
+    AVBufferRef *buf;
+    uint8_t *data, *body, *dst;
+    size_t payload_size = 0, t35_size, payload_len, size_len, obu_size;
+    int ret;
+
+    *out = NULL;
+    if (!sd)
+        return 0;
+    if (sd->size < sizeof(*hdr_plus)) {
+        av_log(avctx, AV_LOG_WARNING, "HDR10+ side data is %d bytes, an AVDynamicHDRPlus is %u, "
+               "skipping\n", sd->size, (unsigned)sizeof(*hdr_plus));
+        return 0;
+    }
+    hdr_plus = (AVDynamicHDRPlus *)sd->data;
+
+    ret = av_dynamic_hdr_plus_to_t35(hdr_plus, NULL, &payload_size);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Error finding the size of HDR10+\n");
+        return ret;
+    }
+
+    /* metadata_type + identity + body + obu_trailing_bits, then the header around it. */
+    t35_size    = HDR10PLUS_T35_HEADER_SIZE + payload_size;
+    payload_len = 1 + t35_size + 1;
+    size_len    = payload_len < 0x80 ? 1 : 2;
+    obu_size    = 1 + size_len + payload_len;
+
+    buf = av_buffer_alloc(obu_size);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    data = buf->data;
+    data[0] = (AV1_OBU_METADATA << 3) | 0x02;  /* obu_type, obu_has_size_field = 1 */
+    if (size_len == 2) {
+        data[1] = (payload_len & 0x7F) | 0x80;
+        data[2] = payload_len >> 7;
+        body    = data + 3;
+    } else {
+        data[1] = payload_len;
+        body    = data + 2;
+    }
+    body[0] = AV1_METADATA_TYPE_ITUT_T35;
+    body[1] = 0xB5;  /* itu_t_t35_country_code: US                          */
+    body[2] = 0x00;  /* itu_t_t35_provider_code: Samsung 0x003C             */
+    body[3] = 0x3C;
+    body[4] = 0x00;  /* provider_oriented_code: 1                           */
+    body[5] = 0x01;
+    body[6] = 0x04;  /* application_identifier                              */
+
+    dst = body + 1 + HDR10PLUS_T35_HEADER_SIZE;
+    ret = av_dynamic_hdr_plus_to_t35(hdr_plus, &dst, &payload_size);
+    if (ret < 0) {
+        av_buffer_unref(&buf);
+        av_log(avctx, AV_LOG_ERROR, "Error encoding HDR10+ from side data\n");
+        return ret;
+    }
+    data[obu_size - 1] = 0x80;  /* obu_trailing_bits: one 1-bit, then zero padding */
+
+    *out = buf;
+    return 0;
+}
+
+static int nvenc_av1_record_insert(int **offsets, int *nb, int *cap, int offset)
+{
+    int *tmp;
+
+    if (*nb == *cap) {
+        tmp = av_realloc_array(*offsets, *cap + 8, sizeof(**offsets));
+        if (!tmp)
+            return AVERROR(ENOMEM);
+        *offsets = tmp;
+        *cap    += 8;
+    }
+    (*offsets)[(*nb)++] = offset;
+    return 0;
+}
+
+/* Insert the picture's metadata OBU into every temporal unit of this packet that does not already
+ * carry an itu_t_t35 one. Placement is directly in front of the unit's LAST picture OBU, which is
+ * the picture the unit displays: that is where libaom, SVT-AV1 and NVENC's own native blocks all
+ * put it, and putting it in front of the first picture instead was measured wrong on 3/12 and 2/12
+ * units of streams that hold several pictures per unit.
+ *
+ * The walk is per temporal unit, not per packet: nothing in the SDK documents that one returned
+ * buffer holds exactly one unit. Anything the walk cannot settle - an OBU without a size field in
+ * the middle of a unit, a unit with no picture OBU - is left byte-for-byte untouched and counted,
+ * because a metadata block at a guessed position is worse than none. */
+static int nvenc_av1_insert_hdr10plus(AVCodecContext *avctx, AVPacket *pkt,
+                                      const AVBufferRef *obu)
+{
+    const uint8_t *buf = pkt->data;
+    const int size = pkt->size;
+    int *offsets = NULL, nb_offsets = 0, offsets_cap = 0;
+    int unit_pic_start = -1, unit_has_t35 = 0, unit_seen = 0;
+    int pos = 0, i, ret, nb_unusable = 0;
+    AVBufferRef *new_buf;
+    uint8_t *dst;
+
+    for (;;) {
+        int type = 0, start_pos = 0, temporal_id = 0, spatial_id = 0, raw;
+        int64_t payload_size = 0;
+
+        if (pos >= size) {
+            if (unit_seen && unit_pic_start < 0)
+                nb_unusable++;
+            if (unit_seen && unit_pic_start >= 0 && !unit_has_t35) {
+                ret = nvenc_av1_record_insert(&offsets, &nb_offsets, &offsets_cap,
+                                              unit_pic_start);
+                if (ret < 0)
+                    goto end;
+            }
+            break;
+        }
+
+        raw = parse_obu_header(buf + pos, size - pos, &payload_size, &start_pos,
+                               &type, &temporal_id, &spatial_id);
+        if (raw < 0 || raw == 0) {
+            av_log(avctx, AV_LOG_VERBOSE, "AV1 output could not be walked at byte %d of %d, "
+                   "leaving this packet's metadata alone\n", pos, size);
+            ret = 0;
+            goto end;
+        }
+
+        if (type == AV1_OBU_TEMPORAL_DELIMITER) {
+            if (unit_seen && unit_pic_start < 0)
+                nb_unusable++;
+            if (unit_seen && unit_pic_start >= 0 && !unit_has_t35) {
+                ret = nvenc_av1_record_insert(&offsets, &nb_offsets, &offsets_cap,
+                                              unit_pic_start);
+                if (ret < 0)
+                    goto end;
+            }
+            unit_pic_start = -1;
+            unit_has_t35   = 0;
+            unit_seen      = 0;
+            pos           += raw;
+            continue;
+        }
+
+        unit_seen = 1;
+        switch (type) {
+        case AV1_OBU_FRAME:
+        case AV1_OBU_FRAME_HEADER:
+            /* last one wins: this is the anchor the OBU goes in front of */
+            unit_pic_start = pos;
+            break;
+        case AV1_OBU_METADATA:
+            if (payload_size >= 1) {
+                /* Every metadata_type the AV1 spec registers is below 128, so the first byte of
+                 * the payload is the whole uleb128 value. */
+                if (buf[pos + start_pos] == AV1_METADATA_TYPE_ITUT_T35)
+                    unit_has_t35 = 1;
+            }
+            break;
+        default:
+            break;
+        }
+        pos += raw;
+    }
+
+    if (!nb_offsets) {
+        if (nb_unusable)
+            av_log(avctx, AV_LOG_VERBOSE, "%d temporal unit(s) in this packet carried no picture "
+                   "OBU to anchor HDR10+ to\n", nb_unusable);
+        ret = 0;
+        goto end;
+    }
+
+    new_buf = av_buffer_alloc(size + nb_offsets * (int)obu->size);
+    if (!new_buf) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    dst    = new_buf->data;
+    pos    = 0;
+    for (i = 0; i < nb_offsets; i++) {
+        memcpy(dst, buf + pos, offsets[i] - pos);
+        dst += offsets[i] - pos;
+        memcpy(dst, obu->data, obu->size);
+        dst += obu->size;
+        pos  = offsets[i];
+    }
+    memcpy(dst, buf + pos, size - pos);
+
+    av_buffer_unref(&pkt->buf);
+    pkt->buf  = new_buf;
+    pkt->data = new_buf->data;
+    pkt->size = size + nb_offsets * (int)obu->size;
+    ret = 0;
+
+end:
+    av_freep(&offsets);
+    return ret;
+}
+#endif /* CONFIG_AV1_NVENC_ENCODER */
+
 static int nvenc_store_frame_data(AVCodecContext *avctx, NV_ENC_PIC_PARAMS *pic_params, const AVFrame *frame)
 {
     NvencContext *ctx = avctx->priv_data;
@@ -2574,6 +2791,15 @@ static int nvenc_store_frame_data(AVCodecContext *avctx, NV_ENC_PIC_PARAMS *pic_
 
     // in case the encoder got reconfigured, there might be leftovers
     av_buffer_unref(&frame_data->frame_opaque_ref);
+    av_buffer_unref(&frame_data->hdr10plus_obu);
+
+#if CONFIG_AV1_NVENC_ENCODER
+    if (avctx->codec->id == AV_CODEC_ID_AV1) {
+        res = nvenc_av1_hdr10plus_obu(avctx, frame, &frame_data->hdr10plus_obu);
+        if (res < 0)
+            return res;
+    }
+#endif
 
     if (frame->opaque_ref && avctx->flags & AV_CODEC_FLAG_COPY_OPAQUE) {
         frame_data->frame_opaque_ref = av_buffer_ref(frame->opaque_ref);
@@ -2607,6 +2833,7 @@ static int nvenc_retrieve_frame_data(AVCodecContext *avctx, NV_ENC_LOCK_BITSTREA
     }
 
     av_buffer_unref(&frame_data->frame_opaque_ref);
+    av_buffer_unref(&frame_data->hdr10plus_obu);
 
     return res;
 }
@@ -2649,6 +2876,25 @@ static int process_output_surface(AVCodecContext *avctx, AVPacket *pkt, NvencSur
         goto error;
     }
 
+#if CONFIG_AV1_NVENC_ENCODER
+    /* The SDK reports which submitted picture this packet came from; that is the picture the
+     * temporal unit displays, so its own metadata is the one to insert. Frames without HDR10+
+     * side data have a NULL here and the packet is returned untouched. */
+    {
+        int fd_idx = (int)lock_params.outputDuration;
+
+        if (fd_idx >= 0 && fd_idx < ctx->frame_data_array_nb) {
+            AVBufferRef *obu = ctx->frame_data_array[fd_idx].hdr10plus_obu;
+
+            if (obu) {
+                res = nvenc_av1_insert_hdr10plus(avctx, pkt, obu);
+                if (res < 0)
+                    goto error;
+            }
+        }
+    }
+#endif
+
 
     if (IS_HWACCEL(avctx->pix_fmt)) {
         ctx->registered_frames[tmpoutsurf->reg_idx].mapped -= 1;
